---
import { ViewTransitions } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { 
  title = 'LACIGE - Laboratorio de Ciencias Geoespaciales',
  description = 'Laboratorio de Ciencias Geoespaciales - Investigaci?n, innovaci?n y divulgaci?n en ciencias del espacio y geof?sica.',
  image = '/favicon.svg'
} = Astro.props;

const favicon = '/favicon.svg';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <link rel="apple-touch-icon" href="/LACIGE_LOGO_NEGRO_VECT.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    
    <!-- Preconnect to Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    
    <!-- DNS Prefetch para recursos comunes -->
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    
    <!-- View Transitions con prefetch habilitado -->
    <ViewTransitions />
    
    <!-- Variables CSS globales -->
    <style is:inline>
      :root {
        --color-primary: #003D79;
        --color-primary-dark: #002a54;
        --color-primary-light: #0056a8;
        --color-accent: #D59F0F;
        --color-accent-dark: #b8890d;
        --color-accent-light: #e8b52a;
        --color-earth: #84754E;
        --color-earth-dark: #6a5d3e;
        --color-earth-light: #a39468;
        --color-white: #FFFFFF;
        --color-off-white: #F8F6F3;
        --color-gray-100: #F1EDE8;
        --color-gray-200: #E3DDD4;
        --color-gray-300: #C9C1B4;
        --color-gray-400: #9E9588;
        --color-gray-500: #73695C;
        --color-gray-600: #4D4538;
        --color-gray-700: #2D2820;
        --color-black: #1A1612;
        --font-display: 'Playfair Display', Georgia, serif;
        --font-body: 'Source Sans 3', -apple-system, BlinkMacSystemFont, sans-serif;
        --space-xs: 0.25rem;
        --space-sm: 0.5rem;
        --space-md: 1rem;
        --space-lg: 1.5rem;
        --space-xl: 2rem;
        --space-2xl: 3rem;
        --space-3xl: 4rem;
        --space-4xl: 6rem;
        --radius-sm: 4px;
        --radius-md: 8px;
        --radius-lg: 16px;
        --radius-full: 9999px;
        --shadow-sm: 0 1px 3px rgba(0, 61, 121, 0.08);
        --shadow-md: 0 4px 12px rgba(0, 61, 121, 0.1);
        --shadow-lg: 0 8px 24px rgba(0, 61, 121, 0.12);
        --shadow-xl: 0 16px 48px rgba(0, 61, 121, 0.16);
        --transition-fast: 150ms ease;
        --transition-base: 250ms ease;
        --transition-slow: 400ms ease;
        --container-max: 1280px;
        --container-narrow: 800px;
      }
    </style>
  </head>
  <body>
    <Header />
    <main transition:animate="none">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  main {
    min-height: calc(100vh - 80px);
  }
</style>

<style is:global>
  /* Variables CSS globales */
  :root {
    /* Colores principales */
    --color-primary: #003D79;
    --color-primary-dark: #002a54;
    --color-primary-light: #0056a8;
    --color-accent: #D59F0F;
    --color-accent-dark: #b8890d;
    --color-accent-light: #e8b52a;
    --color-earth: #84754E;
    --color-earth-dark: #6a5d3e;
    --color-earth-light: #a39468;
    
    /* Neutros */
    --color-white: #FFFFFF;
    --color-off-white: #F8F6F3;
    --color-gray-100: #F1EDE8;
    --color-gray-200: #E3DDD4;
    --color-gray-300: #C9C1B4;
    --color-gray-400: #9E9588;
    --color-gray-500: #73695C;
    --color-gray-600: #4D4538;
    --color-gray-700: #2D2820;
    --color-black: #1A1612;
    
    /* Tipografía */
    --font-display: 'Playfair Display', Georgia, serif;
    --font-body: 'Source Sans 3', -apple-system, BlinkMacSystemFont, sans-serif;
    
    /* Espaciado */
    --space-xs: 0.25rem;
    --space-sm: 0.5rem;
    --space-md: 1rem;
    --space-lg: 1.5rem;
    --space-xl: 2rem;
    --space-2xl: 3rem;
    --space-3xl: 4rem;
    --space-4xl: 6rem;
    
    /* Bordes y sombras */
    --radius-sm: 4px;
    --radius-md: 8px;
    --radius-lg: 16px;
    --radius-full: 9999px;
    
    --shadow-sm: 0 1px 3px rgba(0, 61, 121, 0.08);
    --shadow-md: 0 4px 12px rgba(0, 61, 121, 0.1);
    --shadow-lg: 0 8px 24px rgba(0, 61, 121, 0.12);
    --shadow-xl: 0 16px 48px rgba(0, 61, 121, 0.16);
    
    /* Transiciones */
    --transition-fast: 150ms ease;
    --transition-base: 250ms ease;
    --transition-slow: 400ms ease;
    
    /* Contenedor */
    --container-max: 1280px;
    --container-narrow: 800px;
  }

  /* Transiciones instantaneas */
  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation: none !important;
  }

  ::view-transition-group(*) {
    animation-duration: 0s !important;
  }

  /* Fondo consistente */
  html, body {
    background-color: var(--color-off-white);
  }

  /* Optimizar renderizado de imagenes */
  img {
    content-visibility: auto;
  }

  /* Prefetch styles - indicador visual opcional */
  [data-astro-prefetch] {
    /* Los enlaces con prefetch cargan la pagina en segundo plano */
  }
</style>

<script>
  // Cache de imagenes para evitar recargas
  const imageCache = new Map<string, string>();

  // Precargar imagenes visibles
  function preloadVisibleImages() {
    const images = document.querySelectorAll('img[src]');
    images.forEach(img => {
      const src = img.getAttribute('src');
      if (src && !imageCache.has(src)) {
        imageCache.set(src, src);
      }
    });
  }

  // Restaurar imagenes desde cache despues de navegacion
  function restoreImagesFromCache() {
    const images = document.querySelectorAll('img[src]') as NodeListOf<HTMLImageElement>;
    images.forEach(img => {
      const src = img.getAttribute('src');
      if (src && imageCache.has(src)) {
        // La imagen ya esta en cache del navegador, forzar uso de cache
        if (!img.complete) {
          img.loading = 'eager';
        }
      }
    });
  }

  // Precargar enlaces al hacer hover
  function setupLinkPrefetch() {
    const links = document.querySelectorAll('a[href^="/"]');
    links.forEach(link => {
      link.addEventListener('mouseenter', () => {
        const href = link.getAttribute('href');
        if (href && !link.hasAttribute('data-prefetched')) {
          // Crear link de prefetch
          const prefetchLink = document.createElement('link');
          prefetchLink.rel = 'prefetch';
          prefetchLink.href = href;
          document.head.appendChild(prefetchLink);
          link.setAttribute('data-prefetched', 'true');
        }
      }, { once: true });
    });
  }

  // Ejecutar al cargar la pagina
  document.addEventListener('DOMContentLoaded', () => {
    preloadVisibleImages();
    setupLinkPrefetch();
  });

  // Ejecutar despues de cada navegacion con View Transitions
  document.addEventListener('astro:page-load', () => {
    restoreImagesFromCache();
    preloadVisibleImages();
    setupLinkPrefetch();
  });

  // Antes de la navegacion, guardar imagenes en cache
  document.addEventListener('astro:before-swap', () => {
    preloadVisibleImages();
  });
</script>
