---
// Componente de visor de imágenes solares con navegación
// Se usa tanto en inicio como en la galería solar
// Las imágenes están ordenadas de más reciente a más antigua (índice 0 = más reciente)
// Navegación: izquierda = más antigua, derecha = más reciente

interface ImageData {
  path: string;
  fechaStr: string;
  id: string;
}

interface Props {
  imagenes: ImageData[];
}

const { imagenes } = Astro.props;
const imagenesJSON = JSON.stringify(imagenes);
---

<!-- Visor de imagen (Modal) -->
<div class="solar-viewer" id="solarViewer" aria-hidden="true">
  <div class="solar-viewer__backdrop" id="solarViewerBackdrop"></div>

  <!-- Botón cerrar - siempre visible -->
  <button
    class="solar-viewer__close"
    id="solarViewerClose"
    type="button"
    aria-label="Cerrar visor"
  >
    <svg
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
    >
      <line x1="18" y1="6" x2="6" y2="18"></line>
      <line x1="6" y1="6" x2="18" y2="18"></line>
    </svg>
  </button>

  <!-- Navegación fija - siempre visible en desktop -->
  <button
    class="solar-viewer__nav solar-viewer__nav--prev"
    id="solarViewerPrev"
    type="button"
    aria-label="Imagen más antigua"
  >
    <svg
      width="32"
      height="32"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
    >
      <polyline points="15 18 9 12 15 6"></polyline>
    </svg>
  </button>

  <button
    class="solar-viewer__nav solar-viewer__nav--next"
    id="solarViewerNext"
    type="button"
    aria-label="Imagen más reciente"
  >
    <svg
      width="32"
      height="32"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
    >
      <polyline points="9 18 15 12 9 6"></polyline>
    </svg>
  </button>

  <div class="solar-viewer__wrapper">
    <!-- Header móvil -->
    <div class="solar-viewer__header">
      <div class="solar-viewer__header-info">
        <span class="solar-viewer__header-title">Imagen Solar</span>
        <span class="solar-viewer__header-counter" id="solarViewerCounterMobile"
        ></span>
      </div>
      <button
        class="solar-viewer__close-mobile"
        id="solarViewerCloseMobile"
        type="button"
        aria-label="Cerrar visor"
      >
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Controles de zoom (desktop) -->
    <div class="solar-viewer__zoom-controls" id="solarViewerZoomControls">
      <button
        class="solar-viewer__zoom-btn"
        id="solarViewerZoomIn"
        type="button"
        aria-label="Acercar"
        title="Acercar (+)"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="12" y1="5" x2="12" y2="19"></line>
          <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
      </button>
      <button
        class="solar-viewer__zoom-btn"
        id="solarViewerZoomReset"
        type="button"
        aria-label="Restablecer zoom"
        title="Restablecer (0)"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="8" x2="12" y2="16"></line>
          <line x1="8" y1="12" x2="16" y2="12"></line>
        </svg>
      </button>
      <button
        class="solar-viewer__zoom-btn"
        id="solarViewerZoomOut"
        type="button"
        aria-label="Alejar"
        title="Alejar (-)"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
      </button>
    </div>

    <div class="solar-viewer__content">
      <div class="solar-viewer__main">
        <div
          class="solar-viewer__image-container"
          id="solarViewerImageContainer"
        >
          <div class="solar-viewer__image-wrapper" id="solarViewerImageWrapper">
            <img
              src=""
              alt=""
              class="solar-viewer__image"
              id="solarViewerImage"
              draggable="false"
            />
          </div>
        </div>

        <!-- Toggle para información en móvil -->
        <button
          class="solar-viewer__meta-toggle"
          id="solarViewerMetaToggle"
          type="button"
          aria-expanded="false"
        >
          <span>Ver información</span>
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            style="padding-top: 1.3rem;"
          >
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </button>
      </div>

      <!-- Navegación móvil inferior (fuera de main para posicionamiento fijo) -->
      <div class="solar-viewer__mobile-nav">
        <button
          class="solar-viewer__mobile-btn"
          id="solarViewerPrevMobile"
          type="button"
          aria-label="Imagen más antigua"
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
          <span>Más antigua</span>
        </button>
        <span class="solar-viewer__mobile-date" id="solarViewerDateMobile"
        ></span>
        <button
          class="solar-viewer__mobile-btn"
          id="solarViewerNextMobile"
          type="button"
          aria-label="Imagen más reciente"
        >
          <span>Más reciente</span>
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>

      <div class="solar-viewer__meta">
        <h3 class="solar-viewer__title">Imagen Solar</h3>
        <p class="solar-viewer__date" id="solarViewerDate"></p>
        <div class="solar-viewer__counter" id="solarViewerCounter"></div>
        <div class="solar-viewer__details">
          <div class="solar-viewer__detail">
            <span class="detail-label">Instrumento</span>
            <span class="detail-value">Telescopio Solar H-alpha</span>
          </div>
          <div class="solar-viewer__detail">
            <span class="detail-label">Resolución</span>
            <span class="detail-value">Alta definición</span>
          </div>
          <div class="solar-viewer__detail">
            <span class="detail-label">Ubicación</span>
            <span class="detail-value">LACIGE, ENES Morelia</span>
          </div>
        </div>
        <div class="solar-viewer__actions">
          <a
            href=""
            class="btn btn--primary solar-viewer__download"
            id="solarViewerDownload"
            download
          >
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            Descargar
          </a>
          <a href="/investigacion/galeria-solar" class="btn btn--secondary">
            Ver galería
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Datos para JavaScript -->
<script
  id="solar-viewer-data"
  type="application/json"
  set:html={imagenesJSON}
/>

<script>
  (function () {
    let abortController: AbortController | null = null;

    function initSolarViewer() {
      // Limpiar listeners anteriores
      if (abortController) {
        abortController.abort();
      }
      abortController = new AbortController();
      const signal = abortController.signal;

      // Obtener datos
      const dataScript = document.getElementById("solar-viewer-data");
      if (!dataScript) return;

      let imagenes: Array<{ path: string; fechaStr: string; id: string }>;
      try {
        imagenes = JSON.parse(dataScript.textContent || "[]");
      } catch (e) {
        return;
      }

      if (imagenes.length === 0) return;

      // Elementos del visor
      const viewer = document.getElementById("solarViewer");
      const backdrop = document.getElementById("solarViewerBackdrop");
      const wrapper = document.querySelector(".solar-viewer__wrapper");
      const main = document.querySelector(".solar-viewer__main");
      const meta = document.querySelector(".solar-viewer__meta");
      const closeBtn = document.getElementById("solarViewerClose");
      const closeBtnMobile = document.getElementById("solarViewerCloseMobile");
      const prevBtn = document.getElementById(
        "solarViewerPrev",
      ) as HTMLButtonElement;
      const nextBtn = document.getElementById(
        "solarViewerNext",
      ) as HTMLButtonElement;
      const prevBtnMobile = document.getElementById(
        "solarViewerPrevMobile",
      ) as HTMLButtonElement;
      const nextBtnMobile = document.getElementById(
        "solarViewerNextMobile",
      ) as HTMLButtonElement;
      const image = document.getElementById(
        "solarViewerImage",
      ) as HTMLImageElement;
      const imageContainer = document.getElementById(
        "solarViewerImageContainer",
      );
      const dateEl = document.getElementById("solarViewerDate");
      const dateMobileEl = document.getElementById("solarViewerDateMobile");
      const counterEl = document.getElementById("solarViewerCounter");
      const counterMobileEl = document.getElementById(
        "solarViewerCounterMobile",
      );
      const downloadBtn = document.getElementById(
        "solarViewerDownload",
      ) as HTMLAnchorElement;

      if (!viewer || !image || !downloadBtn || !prevBtn || !nextBtn) return;

      // Asegurar que el visor esté cerrado al iniciar
      viewer.classList.remove("is-open");
      viewer.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";

      let currentIndex = 0;
      let touchStartX = 0;
      let touchEndX = 0;
      let viewerOpenedWithHistory = false;

      function updateViewer() {
        const img = imagenes[currentIndex];
        if (!img || !viewer || !image || !downloadBtn) return;

        image.src = img.path;
        image.alt = `Imagen solar del ${img.fechaStr}`;

        if (dateEl) dateEl.textContent = img.fechaStr;
        if (dateMobileEl) dateMobileEl.textContent = img.fechaStr;

        downloadBtn.href = img.path;

        const counterText = `${currentIndex + 1} de ${imagenes.length}`;
        if (counterEl) counterEl.textContent = counterText;
        if (counterMobileEl) counterMobileEl.textContent = counterText;

        // Navegación invertida:
        // - prevBtn (izquierda) va a imágenes más antiguas (índice mayor)
        // - nextBtn (derecha) va a imágenes más recientes (índice menor)
        const canGoOlder = currentIndex < imagenes.length - 1;
        const canGoNewer = currentIndex > 0;

        // Botones desktop
        prevBtn.disabled = !canGoOlder;
        nextBtn.disabled = !canGoNewer;
        prevBtn.style.opacity = canGoOlder ? "1" : "0.3";
        nextBtn.style.opacity = canGoNewer ? "1" : "0.3";

        // Botones móvil
        if (prevBtnMobile) {
          prevBtnMobile.disabled = !canGoOlder;
          prevBtnMobile.style.opacity = canGoOlder ? "1" : "0.5";
        }
        if (nextBtnMobile) {
          nextBtnMobile.disabled = !canGoNewer;
          nextBtnMobile.style.opacity = canGoNewer ? "1" : "0.5";
        }
      }

      function openViewer(imagePath: string) {
        if (!viewer) return;

        // Encontrar el índice de la imagen
        const index = imagenes.findIndex((img) => img.path === imagePath);
        currentIndex = index >= 0 ? index : 0;

        // Actualizar contenido primero (sin mostrar)
        updateViewer();

        // Mostrar visor con animación CSS
        viewer.classList.add("is-open");
        viewer.setAttribute("aria-hidden", "false");
        document.body.style.overflow = "hidden";

        // Forzar reflow para que la animación funcione
        viewer.offsetHeight;
        viewer.classList.add("is-visible");

        // Añadir entrada al historial para que el botón "regresar" cierre el visor
        if (!viewerOpenedWithHistory) {
          history.pushState({ solarViewerOpen: true }, "");
          viewerOpenedWithHistory = true;
        }
      }

      function closeViewer(fromPopState = false) {
        if (!viewer) return;

        // Iniciar animación de cierre
        viewer.classList.remove("is-visible");

        // Esperar a que termine la animación antes de ocultar
        setTimeout(() => {
          viewer.classList.remove("is-open");
          viewer.setAttribute("aria-hidden", "true");
          document.body.style.overflow = "";
        }, 300);

        // Si no viene del evento popstate, volver atrás en el historial
        if (viewerOpenedWithHistory && !fromPopState) {
          viewerOpenedWithHistory = false;
          history.back();
        } else {
          viewerOpenedWithHistory = false;
        }
      }

      // Ir a imagen más antigua (índice mayor)
      function goToOlder() {
        if (currentIndex < imagenes.length - 1) {
          // Animación de salida
          image.classList.add("slide-out-left");

          setTimeout(() => {
            currentIndex++;
            resetZoom();
            updateViewer();
            image.classList.remove("slide-out-left");
            image.classList.add("slide-in-right");

            setTimeout(() => {
              image.classList.remove("slide-in-right");
            }, 200);
          }, 150);
        }
      }

      // Ir a imagen más reciente (índice menor)
      function goToNewer() {
        if (currentIndex > 0) {
          // Animación de salida
          image.classList.add("slide-out-right");

          setTimeout(() => {
            currentIndex--;
            resetZoom();
            updateViewer();
            image.classList.remove("slide-out-right");
            image.classList.add("slide-in-left");

            setTimeout(() => {
              image.classList.remove("slide-in-left");
            }, 200);
          }, 150);
        }
      }

      // Toggle del panel de información en móvil
      const metaToggle = document.getElementById("solarViewerMetaToggle");
      const content = document.querySelector(".solar-viewer__content");

      function closeInfoPanel() {
        if (content && metaToggle) {
          content.classList.remove("info-expanded");
          metaToggle.classList.remove("is-expanded");
          metaToggle.setAttribute("aria-expanded", "false");
          const toggleText = metaToggle.querySelector("span");
          if (toggleText) {
            toggleText.textContent = "Ver información";
          }
        }
      }

      function toggleInfoPanel() {
        if (!content || !metaToggle) return;
        const isExpanded = content.classList.toggle("info-expanded");
        metaToggle.classList.toggle("is-expanded", isExpanded);
        metaToggle.setAttribute("aria-expanded", isExpanded.toString());

        const toggleText = metaToggle.querySelector("span");
        if (toggleText) {
          toggleText.textContent = isExpanded
            ? "Ocultar información"
            : "Ver información";
        }
      }

      // Event listeners
      if (backdrop) {
        backdrop.addEventListener(
          "click",
          (e) => {
            e.preventDefault();
            e.stopPropagation();
            // Si el panel de info está abierto, solo cerrarlo
            if (content?.classList.contains("info-expanded")) {
              closeInfoPanel();
              return;
            }
            // Si no, cerrar el visor completo
            closeViewer();
          },
          { signal },
        );
      }

      if (closeBtn) {
        closeBtn.addEventListener(
          "click",
          (e) => {
            e.preventDefault();
            e.stopPropagation();
            closeViewer();
          },
          { signal },
        );
      }

      if (closeBtnMobile) {
        closeBtnMobile.addEventListener(
          "click",
          (e) => {
            e.preventDefault();
            e.stopPropagation();
            closeViewer();
          },
          { signal },
        );
      }

      if (metaToggle) {
        metaToggle.addEventListener(
          "click",
          (e) => {
            e.preventDefault();
            e.stopPropagation();
            toggleInfoPanel();
          },
          { signal },
        );
      }

      // Cerrar panel de información al hacer clic en la imagen
      if (imageContainer) {
        imageContainer.addEventListener(
          "click",
          (e) => {
            // Solo cerrar panel info si está abierto
            if (content?.classList.contains("info-expanded")) {
              e.preventDefault();
              e.stopPropagation();
              closeInfoPanel();
            }
          },
          { signal },
        );
      }

      // Botón izquierda = más antigua
      prevBtn.addEventListener(
        "click",
        (e) => {
          e.preventDefault();
          e.stopPropagation();
          goToOlder();
        },
        { signal },
      );

      // Botón derecha = más reciente
      nextBtn.addEventListener(
        "click",
        (e) => {
          e.preventDefault();
          e.stopPropagation();
          goToNewer();
        },
        { signal },
      );

      // Botones móvil
      if (prevBtnMobile) {
        prevBtnMobile.addEventListener(
          "click",
          (e) => {
            e.preventDefault();
            e.stopPropagation();
            goToOlder();
          },
          { signal },
        );
      }

      if (nextBtnMobile) {
        nextBtnMobile.addEventListener(
          "click",
          (e) => {
            e.preventDefault();
            e.stopPropagation();
            goToNewer();
          },
          { signal },
        );
      }

      // Cerrar visor al hacer clic fuera de la imagen o la tarjeta de descripción
      if (wrapper) {
        wrapper.addEventListener(
          "click",
          (e) => {
            const target = e.target as HTMLElement;
            
            // Si el clic fue en el wrapper directamente, cerrar
            if (target === wrapper) {
              closeViewer();
              return;
            }
            
            // Verificar si el clic fue dentro de la imagen o la tarjeta de descripción
            const isInsideImage = main?.contains(target);
            const isInsideMeta = meta?.contains(target);
            
            // Si no está dentro de la imagen ni de la tarjeta, cerrar
            if (!isInsideImage && !isInsideMeta) {
              closeViewer();
            }
          },
          { signal },
        );
      }

      // Teclado (invertido)
      document.addEventListener(
        "keydown",
        (e) => {
          if (!viewer.classList.contains("is-open")) return;

          if (e.key === "Escape") {
            closeViewer();
          } else if (e.key === "ArrowLeft") {
            // Izquierda = más antigua
            goToOlder();
          } else if (e.key === "ArrowRight") {
            // Derecha = más reciente
            goToNewer();
          }
        },
        { signal },
      );

      // Botón regresar del navegador (para móvil principalmente)
      window.addEventListener(
        "popstate",
        (e) => {
          if (viewer.classList.contains("is-open")) {
            // Cerrar el visor sin modificar el historial (ya se hizo con popstate)
            closeViewer(true);
          }
        },
        { signal },
      );

      // Soporte táctil (swipe)
      if (imageContainer) {
        imageContainer.addEventListener(
          "touchstart",
          (e) => {
            touchStartX = e.changedTouches[0].screenX;
          },
          { signal, passive: true },
        );

        imageContainer.addEventListener(
          "touchend",
          (e) => {
            touchEndX = e.changedTouches[0].screenX;
            handleSwipe();
          },
          { signal, passive: true },
        );
      }

      function handleSwipe() {
        const swipeThreshold = 50;
        const diff = touchStartX - touchEndX;

        if (Math.abs(diff) > swipeThreshold) {
          if (diff > 0) {
            // Swipe izquierda = más antigua
            goToOlder();
          } else {
            // Swipe derecha = más reciente
            goToNewer();
          }
        }
      }

      // ========== FUNCIONALIDAD DE ZOOM ==========
      const imageWrapper = document.getElementById("solarViewerImageWrapper") as HTMLElement;
      const zoomInBtn = document.getElementById("solarViewerZoomIn") as HTMLButtonElement;
      const zoomOutBtn = document.getElementById("solarViewerZoomOut") as HTMLButtonElement;
      const zoomResetBtn = document.getElementById("solarViewerZoomReset") as HTMLButtonElement;
      const zoomControls = document.getElementById("solarViewerZoomControls") as HTMLElement;

      let scale = 1;
      let panning = false;
      let pointX = 0;
      let pointY = 0;
      let startX = 0;
      let startY = 0;
      const minScale = 1;
      const maxScale = 5;
      const zoomStep = 0.3;

      function updateTransform() {
        if (!imageWrapper) return;
        imageWrapper.style.transform = `translate(${pointX}px, ${pointY}px) scale(${scale})`;
        
        // Actualizar estado de botones
        if (zoomInBtn) zoomInBtn.disabled = scale >= maxScale;
        if (zoomOutBtn) zoomOutBtn.disabled = scale <= minScale;
        
        // Mostrar/ocultar controles de zoom
        if (zoomControls) {
          zoomControls.classList.toggle("is-active", scale > 1 || scale < 1);
        }
        
        // Agregar/quitar clase de zoom activo
        if (imageContainer) {
          imageContainer.classList.toggle("is-zoomed", scale > 1);
        }
      }

      function resetZoom() {
        scale = 1;
        pointX = 0;
        pointY = 0;
        updateTransform();
      }

      function zoomIn() {
        if (scale < maxScale) {
          scale = Math.min(scale + zoomStep, maxScale);
          updateTransform();
        }
      }

      function zoomOut() {
        if (scale > minScale) {
          scale = Math.max(scale - zoomStep, minScale);
          // Si volvemos a escala 1, resetear posición
          if (scale === 1) {
            pointX = 0;
            pointY = 0;
          }
          updateTransform();
        }
      }

      // Zoom con rueda del ratón
      if (imageContainer) {
        imageContainer.addEventListener(
          "wheel",
          (e) => {
            e.preventDefault();
            const delta = e.deltaY > 0 ? -zoomStep : zoomStep;
            const newScale = Math.max(minScale, Math.min(maxScale, scale + delta));
            
            if (newScale !== scale) {
              scale = newScale;
              if (scale === 1) {
                pointX = 0;
                pointY = 0;
              }
              updateTransform();
            }
          },
          { signal, passive: false }
        );
      }

      // Botones de zoom
      if (zoomInBtn) {
        zoomInBtn.addEventListener("click", (e) => {
          e.preventDefault();
          e.stopPropagation();
          zoomIn();
        }, { signal });
      }

      if (zoomOutBtn) {
        zoomOutBtn.addEventListener("click", (e) => {
          e.preventDefault();
          e.stopPropagation();
          zoomOut();
        }, { signal });
      }

      if (zoomResetBtn) {
        zoomResetBtn.addEventListener("click", (e) => {
          e.preventDefault();
          e.stopPropagation();
          resetZoom();
        }, { signal });
      }

      // Pan/Arrastre cuando está zoomed
      if (imageContainer) {
        imageContainer.addEventListener(
          "mousedown",
          (e) => {
            if (scale > 1) {
              e.preventDefault();
              panning = true;
              startX = e.clientX - pointX;
              startY = e.clientY - pointY;
              imageContainer.classList.add("is-panning");
            }
          },
          { signal }
        );

        document.addEventListener(
          "mousemove",
          (e) => {
            if (!panning || scale <= 1) return;
            e.preventDefault();
            pointX = e.clientX - startX;
            pointY = e.clientY - startY;
            updateTransform();
          },
          { signal }
        );

        document.addEventListener(
          "mouseup",
          () => {
            if (panning) {
              panning = false;
              imageContainer?.classList.remove("is-panning");
            }
          },
          { signal }
        );

        // Doble click para zoom
        imageContainer.addEventListener(
          "dblclick",
          (e) => {
            e.preventDefault();
            e.stopPropagation();
            if (scale > 1) {
              resetZoom();
            } else {
              scale = 2.5;
              updateTransform();
            }
          },
          { signal }
        );
      }

      // Teclado para zoom
      document.addEventListener(
        "keydown",
        (e) => {
          if (!viewer.classList.contains("is-open")) return;

          if (e.key === "0" && (e.ctrlKey || e.metaKey)) {
            e.preventDefault();
            resetZoom();
          } else if (e.key === "+" || e.key === "=") {
            e.preventDefault();
            zoomIn();
          } else if (e.key === "-" || e.key === "_") {
            e.preventDefault();
            zoomOut();
          }
        },
        { signal }
      );

      // Exponer función global para abrir el visor
      (window as any).openSolarViewer = openViewer;

      // Listener para elementos que quieren abrir el visor
      document.addEventListener(
        "click",
        (e) => {
          const target = e.target as HTMLElement;
          const btn = target.closest(
            "[data-solar-viewer]",
          ) as HTMLElement | null;

          if (btn) {
            e.preventDefault();
            e.stopPropagation();
            const imagePath = btn.dataset.solarViewer;
            if (imagePath) {
              openViewer(imagePath);
            }
          }
        },
        { signal },
      );
    }

    // Inicializar
    document.addEventListener("astro:page-load", initSolarViewer);

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initSolarViewer);
    } else {
      initSolarViewer();
    }
  })();
</script>

