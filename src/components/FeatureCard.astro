---
interface Props {
  titulo: string;
  descripcion: string;
  icono: string;
  enlace?: string;
}

const { titulo, descripcion, icono, enlace } = Astro.props;

const iconos: Record<string, string> = {
  sol: `<circle cx="24" cy="24" r="10" stroke="currentColor" stroke-width="2"/><path d="M24 2v4M24 42v4M2 24h4M42 24h4M7.8 7.8l2.8 2.8M35.4 35.4l2.8 2.8M7.8 40.2l2.8-2.8M35.4 12.6l2.8-2.8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>`,
  viento: `<path d="M9.59 4.59A2 2 0 1 1 11 8H2m10.59 11.41A2 2 0 1 0 14 16H2m15.73-8.27A2.5 2.5 0 1 1 19.5 12H2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" transform="translate(4, 8)"/>`,
  publicacion: `<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" transform="translate(4, 4)"/><polyline points="14 2 14 8 20 8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" transform="translate(4, 4)"/><line x1="16" y1="13" x2="8" y2="13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" transform="translate(4, 4)"/><line x1="16" y1="17" x2="8" y2="17" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" transform="translate(4, 4)"/>`,
  divulgacion: `<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" transform="translate(4, 6)"/>`,
  equipo: `<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" transform="translate(6, 3)"/><circle cx="9" cy="7" r="4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" transform="translate(6, 3)"/><path d="M23 21v-2a4 4 0 0 0-3-3.87" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" transform="translate(6, 3)"/><path d="M16 3.13a4 4 0 0 1 0 7.75" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" transform="translate(6, 3)"/>`,
  beca: `<path d="M22 10v6M2 10l10-5 10 5-10 5z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" transform="translate(4, 6)"/><path d="M6 12v5c3 3 9 3 12 0v-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" transform="translate(4, 6)"/>`,
  infraestructura: `<rect x="4" y="2" width="16" height="20" rx="2" ry="2" stroke="currentColor" stroke-width="2" transform="translate(4, 4)"/><line x1="12" y1="18" x2="12" y2="18" stroke="currentColor" stroke-width="2" stroke-linecap="round" transform="translate(4, 4)"/>`,
  historia: `<circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2" transform="translate(4, 4)"/><polyline points="12 6 12 12 16 14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" transform="translate(4, 4)"/>`,
  contacto: `<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" stroke="currentColor" stroke-width="2" transform="translate(4, 6)"/><polyline points="22,6 12,13 2,6" stroke="currentColor" stroke-width="2" transform="translate(4, 6)"/>`,
  sitios: `<circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2" transform="translate(4, 4)"/><line x1="2" y1="12" x2="22" y2="12" stroke="currentColor" stroke-width="2" transform="translate(4, 4)"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" stroke="currentColor" stroke-width="2" transform="translate(4, 4)"/>`,
};

const iconoSVG = iconos[icono] || iconos.sol;
---

<div class="feature-card">
  {enlace ? (
    <a href={enlace} class="feature-card__link">
      <div class="feature-card__icon">
        <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" set:html={iconoSVG} />
      </div>
      <h3 class="feature-card__title">{titulo}</h3>
      <p class="feature-card__description">{descripcion}</p>
      <span class="feature-card__cta">
        Explorar
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </span>
    </a>
  ) : (
    <div class="feature-card__content">
      <div class="feature-card__icon">
        <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" set:html={iconoSVG} />
      </div>
      <h3 class="feature-card__title">{titulo}</h3>
      <p class="feature-card__description">{descripcion}</p>
    </div>
  )}
</div>

<style>
  .feature-card {
    position: relative;
    background-color: var(--color-white);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }

  .feature-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }

  .feature-card__link,
  .feature-card__content {
    display: flex;
    flex-direction: column;
    padding: var(--space-xl);
    text-decoration: none;
    color: inherit;
  }

  .feature-card__icon {
    width: 64px;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
    color: var(--color-white);
    border-radius: var(--radius-md);
    margin-bottom: var(--space-lg);
    transition: transform var(--transition-base);
  }

  .feature-card:hover .feature-card__icon {
    transform: scale(1.05);
  }

  .feature-card__icon svg {
    width: 32px;
    height: 32px;
  }

  .feature-card__title {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: var(--space-sm);
  }

  .feature-card__description {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-gray-500);
    flex-grow: 1;
  }

  .feature-card__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    margin-top: var(--space-lg);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-accent-dark);
    transition: gap var(--transition-fast);
  }

  .feature-card:hover .feature-card__cta {
    gap: var(--space-sm);
  }
</style>
