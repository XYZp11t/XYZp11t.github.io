---
interface Props {
  subtitulo?: string;
  titulo: string;
  descripcion?: string;
  centrado?: boolean;
  claro?: boolean;
}

const { 
  subtitulo, 
  titulo, 
  descripcion, 
  centrado = true,
  claro = false
} = Astro.props;
---

<header class={`section-header ${centrado ? 'section-header--centered' : ''} ${claro ? 'section-header--light' : ''}`}>
  {subtitulo && <span class="section-header__subtitle">{subtitulo}</span>}
  <h2 class="section-header__title">{titulo}</h2>
  <div class="section-header__line"></div>
  {descripcion && <p class="section-header__description">{descripcion}</p>}
</header>

<style>
  .section-header {
    margin-bottom: var(--space-3xl);
  }

  .section-header--centered {
    text-align: center;
  }

  .section-header--centered .section-header__line {
    margin-left: auto;
    margin-right: auto;
  }

  .section-header--centered .section-header__description {
    margin-left: auto;
    margin-right: auto;
  }

  .section-header__subtitle {
    display: block;
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-accent);
    margin-bottom: var(--space-sm);
  }

  .section-header--light .section-header__subtitle {
    color: var(--color-accent-light);
  }

  .section-header__title {
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-weight: 700;
    line-height: 1.2;
    color: var(--color-primary);
  }

  .section-header--light .section-header__title {
    color: var(--color-white);
  }

  .section-header__line {
    width: 80px;
    height: 4px;
    background: linear-gradient(90deg, var(--color-accent), var(--color-earth));
    border-radius: var(--radius-full);
    margin-top: var(--space-md);
  }

  .section-header__description {
    max-width: 640px;
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--color-gray-500);
    margin-top: var(--space-lg);
  }

  .section-header--light .section-header__description {
    color: rgba(255, 255, 255, 0.8);
  }
</style>
