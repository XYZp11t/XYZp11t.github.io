---
interface Props {
  titulo: string;
  descripcion: string;
  fecha: Date;
  autor: string;
  imagen?: string;
  etiquetas?: string[];
  enlace: string;
  destacado?: boolean;
}

const { 
  titulo, 
  descripcion, 
  fecha, 
  autor, 
  imagen, 
  etiquetas = [], 
  enlace,
  destacado = false 
} = Astro.props;

const fechaFormateada = new Intl.DateTimeFormat('es-ES', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC'
}).format(fecha);

// Generar un ID unico para la transicion basado en la imagen
const imageId = imagen ? `card-img-${imagen.replace(/[^a-zA-Z0-9]/g, '-')}` : undefined;
---

<article class={`article-card ${destacado ? 'article-card--featured' : ''}`}>
  <a href={enlace} class="article-card__link" data-astro-prefetch="hover">
    <div class="article-card__image">
      {imagen ? (
        <img 
          src={imagen} 
          alt={titulo} 
          loading="lazy"
          decoding="async"
          fetchpriority={destacado ? "high" : "low"}
          transition:name={imageId}
          transition:animate="none"
        />
      ) : (
        <div class="article-card__placeholder">
          <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="24" cy="24" r="16" stroke="currentColor" stroke-width="1.5"/>
            <circle cx="24" cy="24" r="6" fill="currentColor" opacity="0.3"/>
            <path d="M24 8C24 8 27 14 27 24C27 34 24 40 24 40" stroke="currentColor" stroke-width="1"/>
            <path d="M24 8C24 8 21 14 21 24C21 34 24 40 24 40" stroke="currentColor" stroke-width="1"/>
            <ellipse cx="24" cy="24" rx="16" ry="6" stroke="currentColor" stroke-width="1"/>
          </svg>
        </div>
      )}
      {destacado && <span class="article-card__badge">Destacado</span>}
    </div>
    
    <div class="article-card__content">
      {etiquetas.length > 0 && (
        <div class="article-card__tags">
          {etiquetas.slice(0, 2).map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      )}
      
      <h3 class="article-card__title">{titulo}</h3>
      <p class="article-card__description">{descripcion}</p>
      
      <div class="article-card__meta">
        <span class="article-card__author">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
            <circle cx="12" cy="7" r="4"/>
          </svg>
          {autor}
        </span>
        <span class="article-card__date">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
            <line x1="16" y1="2" x2="16" y2="6"/>
            <line x1="8" y1="2" x2="8" y2="6"/>
            <line x1="3" y1="10" x2="21" y2="10"/>
          </svg>
          {fechaFormateada}
        </span>
      </div>
      
      <span class="article-card__cta">
        Leer más
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </span>
    </div>
  </a>
</article>

<style>
  .article-card {
    background-color: var(--color-white);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }

  .article-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-xl);
  }

  .article-card__link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .article-card__image {
    position: relative;
    aspect-ratio: 16/10;
    overflow: hidden;
    background-color: var(--color-gray-200);
    /* Optimizacion de renderizado */
    contain: layout style paint;
  }

  .article-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow), opacity 0.3s ease;
    /* Optimizacion de renderizado */
    content-visibility: auto;
    /* Evitar layout shift */
    background-color: var(--color-gray-200);
  }

  /* Estado mientras carga */
  .article-card__image img:not([src]),
  .article-card__image img[src=""] {
    opacity: 0;
  }

  .article-card:hover .article-card__image img {
    transform: scale(1.08);
  }

  .article-card__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
    color: rgba(255, 255, 255, 0.3);
  }

  .article-card__placeholder svg {
    width: 80px;
    height: 80px;
  }

  .article-card__badge {
    position: absolute;
    top: var(--space-md);
    left: var(--space-md);
    padding: var(--space-xs) var(--space-sm);
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background-color: var(--color-accent);
    color: var(--color-primary-dark);
    border-radius: var(--radius-sm);
  }

  .article-card__content {
    padding: var(--space-lg);
  }

  .article-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-bottom: var(--space-md);
  }

  .article-card__title {
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-primary);
    margin-bottom: var(--space-sm);
    transition: color var(--transition-fast);
  }

  .article-card:hover .article-card__title {
    color: var(--color-accent-dark);
  }

  .article-card__description {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-gray-500);
    margin-bottom: var(--space-md);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .article-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    font-size: 0.8125rem;
    color: var(--color-gray-400);
    margin-bottom: var(--space-md);
    padding-bottom: var(--space-md);
    border-bottom: 1px solid var(--color-gray-200);
  }

  .article-card__author,
  .article-card__date {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .article-card__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-primary);
    transition: color var(--transition-fast), gap var(--transition-fast);
  }

  .article-card:hover .article-card__cta {
    color: var(--color-accent-dark);
    gap: var(--space-sm);
  }

  /* Featured variant */
  .article-card--featured {
    grid-column: span 2;
  }

  .article-card--featured .article-card__link {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
  }

  .article-card--featured .article-card__image {
    aspect-ratio: auto;
    min-height: 300px;
  }

  .article-card--featured .article-card__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--space-xl);
  }

  .article-card--featured .article-card__title {
    font-size: 1.5rem;
  }

  .article-card--featured .article-card__description {
    -webkit-line-clamp: 4;
  }

  @media (max-width: 900px) {
    .article-card--featured {
      grid-column: span 1;
    }

    .article-card--featured .article-card__link {
      display: block;
    }

    .article-card--featured .article-card__image {
      aspect-ratio: 16/10;
      min-height: auto;
    }
  }
</style>
