---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';

const articulos = await getCollection('divulgacion');
const articulosOrdenados = articulos.sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime());

// Obtener etiquetas únicas
const todasEtiquetas = [...new Set(articulos.flatMap(a => a.data.etiquetas))];
---

<Layout 
  title="Divulgación | LACIGE"
  description="Artículos de divulgación científica del Laboratorio de Ciencias Geoespaciales."
>
  <PageHeader 
    titulo="Divulgación Científica"
    subtitulo="Compartiendo Conocimiento"
  />

  <section class="section">
    <div class="container">


      <!-- Grid de artículos -->
      <div class="articles-grid">
        {articulosOrdenados.map((articulo) => (
          <ArticleCard 
            titulo={articulo.data.titulo}
            descripcion={articulo.data.descripcion}
            fecha={articulo.data.fecha}
            autor={articulo.data.autor}
            imagen={articulo.data.imagen}
            etiquetas={articulo.data.etiquetas}
            enlace={`/divulgacion/${articulo.id}`}
            destacado={false}
          />
        ))}
      </div>

      {articulosOrdenados.length === 0 && (
        <div class="no-articles">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
          </svg>
          <h3>Próximamente</h3>
          <p>Estamos preparando contenido de divulgación. ¡Vuelve pronto!</p>
        </div>
      )}
    </div>
  </section>


</Layout>

<style>


  .articles-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-xl);
  }

  @media (max-width: 1024px) {
    .articles-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .articles-grid {
      grid-template-columns: 1fr;
    }
  }

  .no-articles {
    text-align: center;
    padding: var(--space-4xl) var(--space-xl);
    background-color: var(--color-gray-100);
    border-radius: var(--radius-lg);
  }

  .no-articles svg {
    width: 64px;
    height: 64px;
    color: var(--color-gray-400);
    margin-bottom: var(--space-lg);
  }

  .no-articles h3 {
    font-size: 1.5rem;
    color: var(--color-primary);
    margin-bottom: var(--space-sm);
  }

  .no-articles p {
    color: var(--color-gray-500);
  }


</style>


