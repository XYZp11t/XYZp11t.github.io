---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';

const articulos = await getCollection('divulgacion');
const articulosOrdenados = articulos.sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime());

// Obtener etiquetas únicas
const todasEtiquetas = [...new Set(articulos.flatMap(a => a.data.etiquetas))];
---

<Layout 
  title="Divulgación | LACIGE"
  description="Artículos de divulgación científica del Laboratorio de Ciencias Geoespaciales."
>
  <PageHeader 
    titulo="Divulgación Científica"
    subtitulo="Compartiendo Conocimiento"
  />

  <section class="section">
    <div class="container">
      <!-- Filtros -->
      <div class="filters">
        <button class="filter-btn active" data-filter="all">Todos</button>
        {todasEtiquetas.slice(0, 6).map((etiqueta) => (
          <button class="filter-btn" data-filter={etiqueta}>{etiqueta}</button>
        ))}
      </div>

      <!-- Grid de artículos -->
      <div class="articles-grid">
        {articulosOrdenados.map((articulo) => (
          <ArticleCard 
            titulo={articulo.data.titulo}
            descripcion={articulo.data.descripcion}
            fecha={articulo.data.fecha}
            autor={articulo.data.autor}
            imagen={articulo.data.imagen}
            etiquetas={articulo.data.etiquetas}
            enlace={`/divulgacion/${articulo.id}`}
            destacado={false}
          />
        ))}
      </div>

      {articulosOrdenados.length === 0 && (
        <div class="no-articles">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
          </svg>
          <h3>Próximamente</h3>
          <p>Estamos preparando contenido de divulgación. ¡Vuelve pronto!</p>
        </div>
      )}
    </div>
  </section>

  <!-- Newsletter -->
  <section class="newsletter-section">
    <div class="container">
      <div class="newsletter-content">
        <div class="newsletter-text">
          <h2>Mantente Informado</h2>
          <p>Suscríbete a nuestro boletín para recibir las últimas noticias sobre ciencias geoespaciales.</p>
        </div>
        <form class="newsletter-form">
          <input type="email" placeholder="tu@email.com" required />
          <button type="submit" class="btn btn--accent">Suscribirse</button>
        </form>
      </div>
    </div>
  </section>
</Layout>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-bottom: var(--space-2xl);
    justify-content: center;
  }

  .filter-btn {
    padding: var(--space-sm) var(--space-md);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-gray-600);
    background-color: var(--color-white);
    border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-full);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .filter-btn:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .filter-btn.active {
    background-color: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-white);
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-xl);
  }

  @media (max-width: 1024px) {
    .articles-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .articles-grid {
      grid-template-columns: 1fr;
    }
  }

  .no-articles {
    text-align: center;
    padding: var(--space-4xl) var(--space-xl);
    background-color: var(--color-gray-100);
    border-radius: var(--radius-lg);
  }

  .no-articles svg {
    width: 64px;
    height: 64px;
    color: var(--color-gray-400);
    margin-bottom: var(--space-lg);
  }

  .no-articles h3 {
    font-size: 1.5rem;
    color: var(--color-primary);
    margin-bottom: var(--space-sm);
  }

  .no-articles p {
    color: var(--color-gray-500);
  }

  /* Newsletter */
  .newsletter-section {
    padding: var(--space-4xl) 0;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
  }

  .newsletter-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2xl);
    flex-wrap: wrap;
  }

  .newsletter-text {
    flex: 1;
    min-width: 280px;
  }

  .newsletter-text h2 {
    font-size: 1.75rem;
    color: var(--color-white);
    margin-bottom: var(--space-sm);
  }

  .newsletter-text p {
    color: rgba(255, 255, 255, 0.8);
    margin: 0;
  }

  .newsletter-form {
    display: flex;
    gap: var(--space-md);
    flex: 1;
    max-width: 480px;
  }

  .newsletter-form input {
    flex: 1;
    padding: var(--space-md) var(--space-lg);
    font-size: 1rem;
    border: none;
    border-radius: var(--radius-sm);
    background-color: var(--color-white);
  }

  .newsletter-form input::placeholder {
    color: var(--color-gray-400);
  }

  @media (max-width: 768px) {
    .newsletter-content {
      flex-direction: column;
      text-align: center;
    }

    .newsletter-form {
      width: 100%;
      max-width: none;
      flex-direction: column;
    }
  }
</style>

<script>
  // Filtrado de artículos
  const filterBtns = document.querySelectorAll('.filter-btn');
  const articles = document.querySelectorAll('.articles-grid > *');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const filter = btn.getAttribute('data-filter');
      
      filterBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      
      // Por ahora, simplemente muestra todos
      // La funcionalidad de filtrado real se implementaría con JavaScript
    });
  });
</script>
