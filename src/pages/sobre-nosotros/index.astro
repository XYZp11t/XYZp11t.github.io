---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import FeatureCard from '../../components/FeatureCard.astro';
---

<Layout 
  title="Sobre Nosotros | LACIGE"
  description="Conoce al Laboratorio de Ciencias Geoespaciales, nuestra historia, misión y equipo de investigación."
>
  <PageHeader 
    titulo="Sobre Nosotros"
    subtitulo="LACIGE"
  />

  <section class="about-lacige-section">
    <div class="container">
      <div class="about-lacige-content">
        <SectionHeader 
          subtitulo="Acerca del LACIGE"
          titulo="Laboratorio de Ciencias Geoespaciales"
          centrado={true}
        />
        <div class="about-lacige-text">
          <p>
            El </strong>Laboratorio de Ciencias Geoespaciales (LACIGE)</strong> fue creado durante el segundo semestre del 2015 
            en el campus Morelia de la Universidad Nacional Autónoma de México (<strong>UNAM</strong>). La infraestructura, 
            equipo de cómputo, software e instrumentos de observación, provienen de fondos directos de la UNAM 
            otorgados a la Escuela Nacional de Estudios Superiores unidad Morelia (<strong>ENES</strong>) y de la 
            Secretaría de Ciencia, Humanidades, Tecnología e Innovación (<strong>SECIHTI</strong> )a través del 
            proyecto de infraestructura INFR: 253691 aprobado en ese mismo año.
          </p>
          <p>
            Aquí se desarrollan proyectos de investigación básica en el campo de las Ciencias Espaciales, 
            la Astrofísica y el Cómputo en apoyo a las Geociencias, destacando los siguientes:
          </p>
          <ul class="about-lacige-list">
            <li>Estudio de perturbaciones ionosféricas (PI).</li>
            <li>Cálculo del contenido de electrones (TEC) en la ionosfera terrestre.</li>
            <li>Análisis de imágenes solares con telescopios especiales del LACIGE.</li>
            <li>Estudios de objetos cercanos a la Tierra (NEOs).</li>
            <li>Estudios de plasmas astrofísicos.</li>
            <li>Estudios de ondas e inestabilidades en plasmas espaciales.</li>
          </ul>
          <p class="about-lacige-responsible">
            <strong>Responsable del LACIGE:</strong> Dr. Mario Rodríguez Martínez
          </p>
        </div>
      </div>
    </div>
  </section>


  <!-- Secciones -->
  <section class="section section--gray">
    <div class="container">
      <SectionHeader 
        subtitulo="Explora"
        titulo="Conoce Más Sobre LACIGE"
      />
      
      <div class="grid grid--2">
        <FeatureCard 
          titulo="Nuestra Historia"
          descripcion="Desde nuestra fundación hasta hoy, una trayectoria de investigación y descubrimiento científico."
          icono="historia"
          enlace="/sobre-nosotros/historia"
        />
        <FeatureCard 
          titulo="Infraestructura"
          descripcion="Instalaciones, equipamiento y recursos tecnológicos que hacen posible nuestra investigación."
          icono="infraestructura"
          enlace="/sobre-nosotros/infraestructura"
        />
      </div>
    </div>
  </section>


</Layout>

<style>
  .mission-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-xl);
  }

  .mission-card {
    background-color: var(--color-white);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
    box-shadow: var(--shadow-md);
    text-align: center;
    transition: transform var(--transition-base);
  }

  .mission-card:hover {
    transform: translateY(-4px);
  }

  .mission-card__icon {
    width: 72px;
    height: 72px;
    margin: 0 auto var(--space-lg);
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
    color: var(--color-white);
    border-radius: var(--radius-full);
  }

  .mission-card__icon svg {
    width: 36px;
    height: 36px;
  }

  .mission-card h3 {
    font-size: 1.375rem;
    color: var(--color-primary);
    margin-bottom: var(--space-md);
  }

  .mission-card p {
    font-size: 0.9375rem;
    color: var(--color-gray-600);
    line-height: 1.7;
    margin: 0;
  }



    /* Sección Acerca del LACIGE */
    .about-lacige-section {
    padding: var(--space-4xl) 0;
    background: linear-gradient(180deg, var(--color-off-white) 0%, var(--color-white) 100%);
  }

  .about-lacige-content {
    max-width: 900px;
    margin: 0 auto;
    text-align: center;
  }

  .about-lacige-text {
    margin-top: var(--space-xl);
    text-align: left;
  }

  .about-lacige-text p {
    font-size: 1.0625rem;
    line-height: 1.8;
    color: var(--color-gray-600);
    margin-bottom: var(--space-md);
  }

  .about-lacige-text strong {
    color: var(--color-primary);
    font-weight: 600;
  }

  .about-lacige-list {
    list-style: none;
    padding: 0;
    margin: var(--space-lg) 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-sm) var(--space-xl);
  }

  .about-lacige-list li {
    position: relative;
    padding-left: var(--space-lg);
    font-size: 1rem;
    color: var(--color-gray-600);
    line-height: 1.6;
  }

  .about-lacige-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 10px;
    width: 8px;
    height: 8px;
    background-color: var(--color-accent);
    border-radius: 50%;
  }

  .about-lacige-responsible {
    margin-top: var(--space-xl);
    padding: var(--space-md) var(--space-lg);
    background: var(--color-gray-100);
    border-left: 4px solid var(--color-accent);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    text-align: left;
  }

  .about-lacige-responsible strong {
    color: var(--color-primary);
  }

  @media (max-width: 768px) {
    .about-lacige-list {
      grid-template-columns: 1fr;
    }
  }
</style>
