---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import SectionHeader from '../../components/SectionHeader.astro';



const equipamiento = [
  { nombre: 'Telescopio Solar H-alpha', cantidad: 0},
  { nombre: 'Coronógrafo LACIGE-1', cantidad: 0 },
  { nombre: 'Servidores de cómputo', cantidad: 0 },
  { nombre: 'Estaciones meteorológicas', cantidad: 0 },
  { nombre: 'Cámaras CCD científicas', cantidad: 0 }
];
---

<Layout 
  title="Infraestructura | LACIGE"
  description="Conoce las instalaciones y equipamiento del Laboratorio de Ciencias Geoespaciales."
>
  <PageHeader 
    titulo="Infraestructura"
    subtitulo="Sobre Nosotros"
  />



  <!-- Video Institucional -->
  <section class="section section--gray">
    <div class="container">
      <SectionHeader 
        subtitulo="Video"
        titulo="Conoce Nuestras Instalaciones"
        descripcion="Un recorrido visual por las instalaciones del Laboratorio de Ciencias Geoespaciales."
      />
      
      <div class="video-wrapper">
        <iframe 
          src="https://www.youtube.com/embed/ey6vey7uwls?si=7_E9-nYMgbUELKAe" 
          title="YouTube video player" 
          frameborder="0" 
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
          referrerpolicy="strict-origin-when-cross-origin" 
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </section>

  <!-- Equipamiento -->
  <section class="section">
    <div class="container">
      <SectionHeader 
        subtitulo="Recursos"
        titulo="Equipamiento Científico"
      />
      
      <div class="equipment-grid">
        {equipamiento.map((item) => (
          <div class="equipment-card">
            <span class="equipment-card__quantity">{item.cantidad}</span>
            <span class="equipment-card__name">{item.nombre}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Mapa/Ubicación -->
  <section class="section">
    <div class="container">
      <SectionHeader 
        subtitulo="Ubicación"
        titulo="Encuéntranos"
        
      />
      
      <div class="location-card">
        <div class="location-card__map">
          <iframe 
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3163.766477006448!2d-101.22119373928291!3d19.649393387706027!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x842d0c599c256431%3A0xda01b64116d303ac!2sObservatorio%20Solar%20ENES%20Morelia%20UNAM!5e1!3m2!1ses-419!2smx!4v1769761925906!5m2!1ses-419!2smx"
            width="100%" 
            height="100%" 
            style="border:0; min-height: 350px;" 
            allowfullscreen="" 
            loading="lazy" 
            referrerpolicy="no-referrer-when-downgrade"
            title="Ubicación del Observatorio Solar ENES Morelia UNAM"
          ></iframe>
        </div>
        <div class="location-card__info">
          <h3>Dirección</h3>
          <p>
            ENES Unidad Morelia, Edificio de Investigación I.<br />
             Antigua Carretera a Pátzcuaro No.8701. <br />
            Col. Ex-Hacienda de Sán José de la Huerta. 
            <br />C. P.58190 Morelia, Michoacán, México.
          </p>
          <h4>Horario de atención</h4>
          <p>
            Lunes a Viernes: 9:00 - 17:00<br />
          </p>
          <a href="/contacto" class="btn btn--primary">Contactar</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>


  /* Equipment */
  .equipment-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-lg);
  }

  .equipment-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: var(--space-xl);
    background-color: var(--color-white);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    text-align: center;
  }

  .equipment-card__quantity {
    font-family: var(--font-display);
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--color-primary);
    line-height: 1;
  }

  .equipment-card__name {
    font-size: 0.9375rem;
    color: var(--color-gray-500);
    margin-top: var(--space-sm);
  }

  /* Location */
  .location-card {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: var(--space-2xl);
    background-color: var(--color-white);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
  }

  .location-card__map {
    min-height: 350px;
    overflow: hidden;
  }

  .location-card__map iframe {
    display: block;
    filter: grayscale(20%);
    transition: filter var(--transition-fast);
  }

  .location-card__map:hover iframe {
    filter: grayscale(0%);
  }

  .location-card__info {
    padding: var(--space-xl);
  }

  .location-card__info h3 {
    font-size: 1.25rem;
    color: var(--color-primary);
    margin-bottom: var(--space-md);
  }

  .location-card__info h4 {
    font-size: 1rem;
    color: var(--color-primary);
    margin-top: var(--space-xl);
    margin-bottom: var(--space-sm);
  }

  .location-card__info p {
    font-size: 0.9375rem;
    color: var(--color-gray-600);
    line-height: 1.7;
  }

  .location-card__info .btn {
    margin-top: var(--space-xl);
  }

  /* Video */
  .video-wrapper {
    position: relative;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-xl);
  }

  .video-wrapper iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  @media (max-width: 1024px) {

    .location-card {
      grid-template-columns: 1fr;
    }
  }
</style>
