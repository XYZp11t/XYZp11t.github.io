---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHeader from '../components/SectionHeader.astro';

const infoContacto = [
  {
    tipo: 'Dirección',
    icono: 'ubicacion',
    valor: 'ENES Unidad Morelia, Edificio de Investigación I. Antigua Carretera a Pátzcuaro No.8701. Col. Ex-Hacienda de Sán José de la Huerta. C. P.58190 Morelia, Michoacán, México.',
    enlace: null
  },
  {
    tipo: 'Correo Electrónico',
    icono: 'email',
    valor: 'por definir',
    enlace: 'mailto:lacige@universidad.edu'
  },
  {
    tipo: 'Teléfono',
    icono: 'telefono',
    valor: ' +52 (443) 689 35 00. Desde el D.F. 5623 73 00. Ext.-UNAM: 80557.',
    enlace: 'tel:+524436893500'
  },
  {
    tipo: 'Horario de Atención',
    icono: 'horario',
    valor: 'Lunes a Viernes: 9:00 - 17:00',
    enlace: null
  }
];

const iconos: Record<string, string> = {
  ubicacion: '<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>',
  email: '<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>',
  telefono: '<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>',
  horario: '<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>'
};
---

<Layout 
  title="Contacto | LACIGE"
  description="Ponte en contacto con el Laboratorio de Ciencias Geoespaciales."
>
  <PageHeader 
    titulo="Contacto"
    subtitulo="Comunícate con Nosotros"
  />

  <section class="section">
    <div class="container">
      <div class="contact-grid">
        <!-- Formulario -->
        <div class="contact-form-wrapper">
          <h2>Envíanos un Mensaje</h2>
          <form 
            class="contact-form" 
            id="contactForm"
            action="https://docs.google.com/forms/d/e/1FAIpQLSfQgXZ6b2l_1vbqfGlF8YuBcbZTaE0L5QlVQUb-N2RNgmjdYw/formResponse"
            method="POST"
            target="_blank"
          >
            <!-- Campo honeypot para detectar bots (oculto) -->
            <div class="form-group form-group--honeypot" aria-hidden="true">
              <label for="website">No llenar este campo</label>
              <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
            </div>

            <div class="form-group">
              <label for="nombre">Nombre completo *</label>
              <input type="text" id="nombre" name="entry.1258781161" required />
            </div>
            
            <div class="form-row">
              <div class="form-group">
                <label for="email">Correo electrónico *</label>
                <input type="email" id="email" name="entry.735313291" required />
                <span class="form-error" id="email-error"></span>
              </div>
              <div class="form-group">
                <label for="telefono">Teléfono</label>
                <input type="tel" id="telefono" name="telefono" />
              </div>
            </div>
            
            <div class="form-group">
              <label for="asunto">Asunto *</label>
              <select id="asunto" name="asunto" required>
                <option value="">Selecciona una opción</option>
                <option value="Información general">Información general</option>
                <option value="Propuesta de colaboración">Propuesta de colaboración</option>
                <option value="Becas y oportunidades">Becas y oportunidades</option>
                <option value="Solicitud de visita">Solicitud de visita</option>
                <option value="Prensa y medios">Prensa y medios</option>
                <option value="Otro">Otro</option>
              </select>
            </div>
            
            <div class="form-group">
              <label for="mensaje">Mensaje *</label>
              <textarea id="mensaje" name="entry.2025781092" rows="5" required></textarea>
            </div>
            
            <!--
            <div class="form-group form-group--checkbox">
              <input type="checkbox" id="privacidad" name="privacidad" required />
              <label for="privacidad">
                He leído y acepto la <a href="/privacidad">política de privacidad</a>
              </label>
            </div> -->
            
            <button type="submit" class="btn btn--primary btn--full">
              Enviar Mensaje
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="22" y1="2" x2="11" y2="13"/>
                <polygon points="22 2 15 22 11 13 2 9 22 2"/>
              </svg>
            </button>
          </form>
        </div>

        <!-- Información de contacto -->
        <div class="contact-info">
          <h2>Información de Contacto</h2>
          
          <div class="contact-items">
            {infoContacto.map((info) => (
              <div class="contact-item">
                <div class="contact-item__icon">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" set:html={iconos[info.icono]} />
                </div>
                <div class="contact-item__content">
                  <span class="contact-item__label">{info.tipo}</span>
                  {info.enlace ? (
                    <a href={info.enlace} class="contact-item__value">{info.valor}</a>
                  ) : (
                    <span class="contact-item__value">{info.valor}</span>
                  )}
                </div>
              </div>
            ))}
          </div>

          <!-- Mapa -->
          <div class="contact-map">
            <iframe 
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3163.766477006448!2d-101.22119373928291!3d19.649393387706027!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x842d0c599c256431%3A0xda01b64116d303ac!2sObservatorio%20Solar%20ENES%20Morelia%20UNAM!5e1!3m2!1ses-419!2smx!4v1769761925906!5m2!1ses-419!2smx"
              width="100%" 
              height="250" 
              style="border:0; border-radius: var(--radius-lg);" 
              allowfullscreen="" 
              loading="lazy" 
              referrerpolicy="no-referrer-when-downgrade"
              title="Ubicación del Observatorio Solar ENES Morelia UNAM"
            ></iframe>
          </div>

          <!-- Redes sociales 
          <div class="contact-social">
            <h3>Síguenos</h3>
            <div class="social-links">
              <a href="#" class="social-link" aria-label="Twitter">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"/>
                </svg>
              </a>
              <a href="#" class="social-link" aria-label="YouTube">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"/>
                  <polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"/>
                </svg>
              </a>
              <a href="#" class="social-link" aria-label="LinkedIn">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
                  <rect x="2" y="9" width="4" height="12"/>
                  <circle cx="4" cy="4" r="2"/>
                </svg>
              </a>
              <a href="#" class="social-link" aria-label="GitHub">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/>
                </svg>
              </a>
            </div>
          </div> -->
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section--gray">
    <div class="container container--narrow">
      <SectionHeader 
        subtitulo="FAQ"
        titulo="Preguntas Frecuentes"
      />
      
      <div class="faq-list">
        <details class="faq-item">
          <summary>¿Cómo puedo visitar las instalaciones de LACIGE?</summary>
          <p>
            Organizamos visitas guiadas para grupos escolares y académicos. Para solicitar una visita, 
            envíanos un correo electrónico con al menos dos semanas de anticipación indicando la fecha 
            deseada, número de personas y nivel educativo del grupo.
          </p>
        </details>
        
        <details class="faq-item">
          <summary>¿Ofrecen servicio social para estudiantes?</summary>
          <p>
            Sí, contamos con programas de servicio social para estudiantes de licenciatura en física, 
            matemáticas, computación y áreas afines. Consulta la sección de Becas para más información.
          </p>
        </details>
        
        <details class="faq-item">
          <summary>¿Cómo puedo colaborar con el laboratorio?</summary>
          <p>
            Estamos abiertos a colaboraciones con instituciones académicas y de investigación. 
            Envíanos una propuesta detallada describiendo el tipo de colaboración que te interesa 
            y los objetivos que deseas alcanzar.
          </p>
        </details>
        
        <details class="faq-item">
          <summary>¿Realizan actividades de divulgación para el público general?</summary>
          <p>
            Sí, organizamos charlas, talleres y eventos especiales durante fechas astronómicas 
            relevantes. Síguenos en redes sociales para estar al tanto de nuestras actividades.
          </p>
        </details>
      </div>
    </div>
  </section>
</Layout>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: var(--space-4xl);
  }

  /* Formulario */
  .contact-form-wrapper h2 {
    font-size: 1.5rem;
    color: var(--color-primary);
    margin-bottom: var(--space-xl);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg);
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .form-group label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-gray-600);
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    padding: var(--space-md);
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--color-gray-700);
    background-color: var(--color-white);
    border: 1px solid var(--color-gray-300);
    border-radius: var(--radius-md);
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(0, 61, 121, 0.1);
  }

  .form-group textarea {
    resize: vertical;
    min-height: 120px;
  }

  .form-group--checkbox {
    flex-direction: row;
    align-items: center;
    gap: var(--space-sm);
  }

  .form-group--checkbox input {
    width: 18px;
    height: 18px;
    accent-color: var(--color-primary);
  }

  .form-group--checkbox label {
    font-weight: 400;
    color: var(--color-gray-500);
  }

  .form-group--checkbox a {
    color: var(--color-primary);
    text-decoration: underline;
  }

  /* Campo honeypot - oculto para humanos, visible para bots */
  .form-group--honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
    overflow: hidden;
  }

  .form-error {
    display: none;
    font-size: 0.875rem;
    color: #dc2626;
    margin-top: var(--space-xs);
  }

  .form-error.is-visible {
    display: block;
  }

  .form-group input.is-invalid {
    border-color: #dc2626;
    box-shadow: 0 0 0 3px rgba(220, 38, 38, 0.1);
  }

  .btn--full {
    width: 100%;
  }

  /* Info contacto */
  .contact-info h2 {
    font-size: 1.5rem;
    color: var(--color-primary);
    margin-bottom: var(--space-xl);
  }

  .contact-items {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    margin-bottom: var(--space-xl);
  }

  .contact-item {
    display: flex;
    gap: var(--space-md);
  }

  .contact-item__icon {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
    color: var(--color-white);
    border-radius: var(--radius-md);
  }

  .contact-item__icon svg {
    width: 24px;
    height: 24px;
  }

  .contact-item__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .contact-item__label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-gray-500);
    margin-bottom: var(--space-xs);
  }

  .contact-item__value {
    font-size: 0.9375rem;
    color: var(--color-gray-700);
  }

  a.contact-item__value {
    color: var(--color-primary);
    text-decoration: none;
  }

  a.contact-item__value:hover {
    text-decoration: underline;
  }

  /* Mapa */
  .contact-map {
    margin-bottom: var(--space-xl);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
  }

  .contact-map iframe {
    display: block;
    filter: grayscale(20%);
    transition: filter var(--transition-fast);
  }

  .contact-map:hover iframe {
    filter: grayscale(0%);
  }

  /* Social */
  .contact-social h3 {
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-gray-500);
    margin-bottom: var(--space-md);
  }

  .social-links {
    display: flex;
    gap: var(--space-sm);
  }

  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    color: var(--color-gray-500);
    background-color: var(--color-gray-100);
    border-radius: var(--radius-full);
    transition: all var(--transition-fast);
  }

  .social-link:hover {
    color: var(--color-white);
    background-color: var(--color-primary);
  }

  .social-link svg {
    width: 20px;
    height: 20px;
  }

  /* FAQ */
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .faq-item {
    background-color: var(--color-white);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }

  .faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-lg);
    font-weight: 600;
    color: var(--color-primary);
    cursor: pointer;
    list-style: none;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item summary::after {
    content: '+';
    font-size: 1.25rem;
    color: var(--color-accent);
    transition: transform var(--transition-fast);
  }

  .faq-item[open] summary::after {
    transform: rotate(45deg);
  }

  .faq-item p {
    padding: 0 var(--space-lg) var(--space-lg);
    color: var(--color-gray-600);
    line-height: 1.7;
    margin: 0;
  }

  @media (max-width: 1024px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .form-row {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Lista de dominios de correo temporales/spam comunes
  const blockedDomains = [
    'tempmail.com', '10minutemail.com', 'guerrillamail.com', 'throwawaymail.com',
    'yopmail.com', 'mailinator.com', 'sharklasers.com', 'getairmail.com',
    'temp-mail.ru', 'fakeemail.net', 'tempmailaddress.com', 'burnermail.io',
    'tempail.com', 'emailtemporanea.net', 'tempmailo.com', 'tmpmail.org',
    'disposableemail.com', 'tempinbox.com', 'mailnesia.com', 'tempmailbox.com',
    'sharklasers.com', 'spam4.me', 'trashmail.com', 'mytrashmail.com'
  ];

  const form = document.getElementById('contactForm') as HTMLFormElement;
  const mensajeField = document.getElementById('mensaje') as HTMLTextAreaElement;
  const asuntoField = document.getElementById('asunto') as HTMLSelectElement;
  const telefonoField = document.getElementById('telefono') as HTMLInputElement;
  const emailField = document.getElementById('email') as HTMLInputElement;
  const honeypotField = document.getElementById('website') as HTMLInputElement;
  const emailError = document.getElementById('email-error') as HTMLSpanElement;

  // Función para validar email
  function isValidEmail(email: string): boolean {
    // Regex para validar formato de email
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!emailRegex.test(email)) return false;

    // Verificar que no sea un dominio bloqueado
    const domain = email.split('@')[1]?.toLowerCase();
    if (domain && blockedDomains.includes(domain)) return false;

    return true;
  }

  // Función para mostrar error
  function showEmailError(message: string) {
    if (emailError) {
      emailError.textContent = message;
      emailError.classList.add('is-visible');
    }
    if (emailField) {
      emailField.classList.add('is-invalid');
    }
  }

  // Función para limpiar error
  function clearEmailError() {
    if (emailError) {
      emailError.textContent = '';
      emailError.classList.remove('is-visible');
    }
    if (emailField) {
      emailField.classList.remove('is-invalid');
    }
  }

  // Limpiar error al escribir
  emailField?.addEventListener('input', clearEmailError);

  form?.addEventListener('submit', (e) => {
    // 1. Validar honeypot (si está lleno, es un bot)
    if (honeypotField?.value) {
      e.preventDefault();
      console.log('Bot detectado - honeypot llenado');
      return;
    }

    // 2. Validar correo electrónico
    const email = emailField?.value || '';
    if (!isValidEmail(email)) {
      e.preventDefault();
      const domain = email.split('@')[1]?.toLowerCase();
      if (domain && blockedDomains.includes(domain)) {
        showEmailError('Por favor utiliza un correo electrónico válido (no se aceptan correos temporales).');
      } else {
        showEmailError('Por favor introduce un correo electrónico válido.');
      }
      emailField?.focus();
      return;
    }

    // 3. Combinar asunto y teléfono con el mensaje
    const asunto = asuntoField?.value || '';
    const telefono = telefonoField?.value || '';
    const mensajeOriginal = mensajeField?.value || '';
    
    let mensajeCompleto = '';
    
    if (asunto) {
      mensajeCompleto += `[Asunto: ${asunto}]\n\n`;
    }
    
    if (telefono) {
      mensajeCompleto += `[Teléfono: ${telefono}]\n\n`;
    }
    
    mensajeCompleto += mensajeOriginal;
    
    // Actualizar el campo de mensaje con la información combinada
    if (mensajeField) {
      mensajeField.value = mensajeCompleto;
    }
    
    // Mostrar mensaje de confirmación
    setTimeout(() => {
      alert('¡Gracias por tu mensaje! Te contactaremos pronto.');
      form.reset();
    }, 500);
  });
</script>
