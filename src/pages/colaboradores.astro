---

<Layout 
  title="Colaboradores | LACIGE"
  description="Investigadores e instituciones que colaboran con el Laboratorio de Ciencias Geoespaciales."
>
  <PageHeader 
    titulo="Colaboradores"
    subtitulo="Red de Aliados"
  />

  <!-- Colaboradores Internos -->
  <section class="section section--gray section--internal">
    <div class="container">
      <SectionHeader 
        subtitulo="Colaboradores Internos"
        titulo="Académicos"
        descripcion="Equipo académico y técnico que impulsa las líneas de investigación de LACIGE."
      />
      
      <div class="institutions-wrapper">
        {colaboradoresInternos.map((grupo) => (
          <div class="institution-block">
            <div class="institution-header">
              <span class="institution-header__badge">{grupo.siglas}</span>
              <h3 class="institution-header__title">{grupo.institucion}</h3>
            </div>
            
            <div class="researchers-grid">
              {grupo.investigadores.map((investigador) => {
                const perfil: PerfilInvestigador = investigador.perfil ?? {};
                const { cargo, areaEstudio, oficina, telefono, email } = perfil;

                return (
                  <article class={`researcher-card ${investigador.esEncargado ? 'researcher-card--leader' : ''}`}>
                    <div class="researcher-card__image">
                      {investigador.esEncargado && (
                        <span class="researcher-card__badge">
                          <svg viewBox="0 0 24 24" fill="currentColor" width="10" height="10">
                            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                          </svg>
                          Encargado LACIGE
                        </span>
                      )}
                      {investigador.imagen ? (
                        <img src={investigador.imagen} alt={investigador.nombre} loading="lazy" decoding="async" />
                      ) : (
                        <div class="researcher-card__placeholder">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
                            <circle cx="12" cy="8" r="4"/>
                            <path d="M4 20c0-4 4-6 8-6s8 2 8 6"/>
                          </svg>
                        </div>
                      )}
                    </div>
                    
                    <div class="researcher-card__content">
                      <div class="researcher-card__header">
                        <h4 class="researcher-card__name">{investigador.nombre}</h4>
                        {cargo && <p class="researcher-card__role">{cargo}</p>}
                      </div>
                      
                      {areaEstudio && (
                        <p class="researcher-card__area">{areaEstudio}</p>
                      )}
                      
                      {(oficina || telefono || email) && (
                        <div class="researcher-card__contact">
                          {oficina && (
                            <span class="researcher-card__info">
                              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M3 21h18M5 21V5a2 2 0 012-2h10a2 2 0 012 2v16"/>
                              </svg>
                              {oficina}
                            </span>
                          )}
                          
                          {telefono && (
                            <span class="researcher-card__info">
                              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/>
                              </svg>
                              {telefono}
                            </span>
                          )}
                          
                          {email && (
                            <a href={`mailto:${email}`} class="researcher-card__info researcher-card__info--link">
                              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                                <polyline points="22,6 12,13 2,6"/>
                              </svg>
                              {email}
                            </a>
                          )}
                        </div>
                      )}
                    </div>
                  </article>
                );
              })}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Colaboradores Externos -->
  <section class="section section--external">
    <div class="container">
      <SectionHeader 
        subtitulo="Colaboradores Externos"
        titulo="Investigadores Asociados"
        descripcion="Red de investigadores de diversas instituciones que colaboran con LACIGE en proyectos de ciencias geoespaciales."
      />
      
      <div class="institutions-wrapper">
        {colaboradoresExternos.map((grupo) => (
          <div class="institution-block">
            <div class="institution-header">
              <span class="institution-header__badge">{grupo.siglas}</span>
              <h3 class="institution-header__title">{grupo.institucion}</h3>
            </div>
            
            <div class="researchers-grid">
              {grupo.investigadores.map((investigador) => {
                const perfil: PerfilInvestigador = investigador.perfil ?? {};
                const { cargo, areaEstudio, oficina, telefono, email } = perfil;

                return (
                  <article class="researcher-card">
                    <div class="researcher-card__image">
                      {investigador.imagen ? (
                        <img src={investigador.imagen} alt={investigador.nombre} loading="lazy" decoding="async" />
                      ) : (
                        <div class="researcher-card__placeholder">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
                            <circle cx="12" cy="8" r="4"/>
                            <path d="M4 20c0-4 4-6 8-6s8 2 8 6"/>
                          </svg>
                        </div>
                      )}
                    </div>
                    
                    <div class="researcher-card__content">
                      <div class="researcher-card__header">
                        <h4 class="researcher-card__name">{investigador.nombre}</h4>
                        {cargo && <p class="researcher-card__role">{cargo}</p>}
                      </div>
                      
                      {areaEstudio && (
                        <p class="researcher-card__area">{areaEstudio}</p>
                      )}
                      
                      {(oficina || telefono || email) && (
                        <div class="researcher-card__contact">
                          {oficina && (
                            <span class="researcher-card__info">
                              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M3 21h18M5 21V5a2 2 0 012-2h10a2 2 0 012 2v16"/>
                              </svg>
                              {oficina}
                            </span>
                          )}
                          
                          {telefono && (
                            <span class="researcher-card__info">
                              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/>
                              </svg>
                              {telefono}
                            </span>
                          )}
                          
                          {email && (
                            <a href={`mailto:${email}`} class="researcher-card__info researcher-card__info--link">
                              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                                <polyline points="22,6 12,13 2,6"/>
                              </svg>
                              {email}
                            </a>
                          )}
                        </div>
                      )}
                    </div>
                  </article>
                );
              })}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>



  <!-- Llamado a colaborar -->
  <section class="section section--primary">
    <div class="container">
      <div class="cta-content">
        <h2>¿Interesado en Colaborar?</h2>
        <p>
          Estamos abiertos a nuevas colaboraciones con instituciones académicas, 
          centros de investigación y organizaciones interesadas en las ciencias geoespaciales.
        </p>
        <a href="/contacto" class="btn btn--accent">Contáctanos</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Institutions Wrapper */
  .institutions-wrapper {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
  }

  .institution-block {
    /* Sin fondo, solo separación */
  }

  .section--internal {
    box-shadow: inset 0 -1px 0 var(--color-gray-200);
  }

  .section--external {
    box-shadow: inset 0 1px 0 var(--color-gray-200);
  }

  .institution-header {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
    padding-bottom: var(--space-md);
    border-bottom: 2px solid var(--color-gray-200);
  }

  .institution-header__badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-xs) var(--space-sm);
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-white);
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
    border-radius: var(--radius-sm);
  }

  .institution-header__title {
    font-size: 1rem;
    color: var(--color-primary);
    margin: 0;
    font-weight: 600;
  }

  /* Researchers Grid - máximo 3 columnas con ancho relativo al viewport */
  .researchers-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: clamp(var(--space-md), 2vw, var(--space-lg));
    width: 100%;
  }

  @media (min-width: 1024px) {
    .researchers-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: clamp(var(--space-md), 1.5vw, var(--space-xl));
    }
  }

  /* Researcher Card - basado en ArticleCard (compacto) */
  .researcher-card {
    display: grid;
    grid-template-columns: clamp(100px, 12vw, 140px) 1fr;
    background-color: var(--color-white);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    transition: transform var(--transition-base), box-shadow var(--transition-base);
    min-height: clamp(140px, 15vw, 160px);
  }

  /* Variante para el encargado del laboratorio */
  .researcher-card--leader {
    border: 2px solid var(--color-accent);
    box-shadow: var(--shadow-lg), 0 0 0 1px var(--color-accent-light);
  }

  .researcher-card--leader:hover {
    box-shadow: var(--shadow-xl), 0 0 0 2px var(--color-accent);
  }

  .researcher-card__badge {
    position: absolute;
    bottom: var(--space-sm);
    left: var(--space-sm);
    right: var(--space-sm);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    padding: 4px 8px;
    font-size: 0.625rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    background: linear-gradient(135deg, var(--color-accent) 0%, var(--color-accent-dark) 100%);
    color: var(--color-primary-dark);
    border-radius: var(--radius-sm);
    z-index: 2;
    white-space: nowrap;
  }

  .researcher-card__badge svg {
    width: 10px;
    height: 10px;
    flex-shrink: 0;
  }

  .researcher-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-xl);
  }

  .researcher-card__image {
    position: relative;
    height: 100%;
    min-height: 100%;
    overflow: hidden;
    background-color: var(--color-gray-200);
    contain: layout style paint;
  }

  .researcher-card__image img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow), opacity 0.3s ease;
    content-visibility: auto;
    background-color: var(--color-gray-200);
  }

  .researcher-card:hover .researcher-card__image img {
    transform: scale(1.08);
  }

  .researcher-card__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
    color: rgba(255, 255, 255, 0.3);
  }

  .researcher-card__placeholder svg {
    width: 50%;
    height: 50%;
  }

  .researcher-card__content {
    padding: var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .researcher-card__header {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .researcher-card__name {
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-primary);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .researcher-card__role {
    font-size: 0.75rem;
    color: var(--color-gray-500);
    margin: 0;
    line-height: 1.4;
  }

  .researcher-card__area {
    font-size: 0.75rem;
    color: var(--color-earth);
    margin: 0;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .researcher-card__contact {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-top: var(--space-xs);
    padding-top: var(--space-xs);
    border-top: 1px solid var(--color-gray-200);
  }

  .researcher-card__info {
    display: flex;
    align-items: flex-start;
    gap: 6px;
    font-size: 0.6875rem;
    color: var(--color-gray-500);
    line-height: 1.3;
    word-break: break-word;
  }

  .researcher-card__info svg {
    flex-shrink: 0;
    width: 12px;
    height: 12px;
    margin-top: 1px;
    color: var(--color-gray-400);
  }

  .researcher-card__info--link {
    text-decoration: none;
    color: var(--color-primary);
    transition: color var(--transition-fast);
  }

  .researcher-card__info--link:hover {
    color: var(--color-accent);
  }



  /* CTA */
  .cta-content {
    text-align: center;
    max-width: 600px;
    margin: 0 auto;
  }

  .cta-content h2 {
    color: var(--color-white);
    margin-bottom: var(--space-md);
  }

  .cta-content p {
    color: rgba(255, 255, 255, 0.85);
    margin-bottom: var(--space-xl);
  }

  /* Responsive */
  @media (max-width: 1024px) {


    .researchers-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 768px) {
    .researcher-card {
      grid-template-columns: clamp(90px, 25vw, 120px) 1fr;
      min-height: 130px;
    }

    .researcher-card__image {
      min-height: 130px;
