---
import Layout from '../../layouts/Layout.astro';
import { readdir, stat } from 'node:fs/promises';
import { join } from 'node:path';

// Detecta automáticamente el video y poster más recientes en public/sw-prediction/
const swDir = join(process.cwd(), 'public', 'sw-prediction');
const dirFiles = await readdir(swDir);

const videoPattern = /^cr(\d+)\.mp4$/;
const videos = dirFiles
  .filter(f => videoPattern.test(f))
  .map(f => ({ file: f, cr: parseInt(f.match(videoPattern)![1], 10) }))
  .sort((a, b) => b.cr - a.cr);

const latest = videos[0];
const videoSrc = `/sw-prediction/${latest.file}`;
const posterSrc = `/sw-prediction/poster_cr${latest.cr}.png`;

// Fecha de modificación del video más reciente
const videoStat = await stat(join(swDir, latest.file));
const videoDate = videoStat.mtime.toISOString().split('T')[0];
---

<Layout 
  title="Simulaciones globales MHD de corrientes de viento solar usando sunRunner3D | LACIGE"
  description="Simulaciones globales MHD de corrientes de viento solar generadas con el modelo sunRunner3D a partir de magnetogramas solares."
>
  <!-- Header minimalista con fecha/hora y selector de idioma -->
  <section class="prediction-header">
    <div class="container">
      <div class="prediction-header__content">
        <div class="prediction-header__info">
          <span class="prediction-header__label" id="section-label">Investigación</span>
          <h1 class="prediction-header__title" id="page-title">Simulaciones globales MHD de corrientes de viento solar usando sunRunner3D</h1>
        </div>
        <div class="prediction-header__controls">
          <div class="datetime" id="datetime" aria-live="polite"></div>
          <div class="lang-switch">
            <button id="lang-toggle" class="lang-switch__btn" aria-haspopup="true" aria-expanded="false">
              <svg class="lang-switch__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 8l6 6"></path>
                <path d="M4 14l6-6 2-3"></path>
                <path d="M2 5h12"></path>
                <path d="M7 2h1"></path>
                <path d="M22 22l-5-10-5 10"></path>
                <path d="M14 18h6"></path>
              </svg>
              <span id="lang-current">ES</span>
            </button>
            <div id="lang-dropdown" class="lang-dropdown" hidden>
              <button class="lang-option" data-lang="es">Español</button>
              <button class="lang-option" data-lang="en">English</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Seccion principal del video -->
  <section class="video-section">
    <div class="container">
      <div class="video-wrapper">
        <div class="video-frame">
          <video
            class="video-player"
            preload="metadata"
            controls
            playsinline
            poster={posterSrc}
            data-video>  
            <source
              src={videoSrc}
              type="video/mp4">
          </video>
        </div>
      </div>
      <div class="video-info">
        <p class="video-info__timestamp">
          <strong id="timestamp-label">Actualizado el:</strong> <span id="video-date">{videoDate}</span>
        </p>
        <p class="video-info__description" id="video-description"> 
          Esta visualización muestra las corrientes de viento solar simuladas con el modelo <a href="https://github.com/predsci/sunRunner3D-manuscript" target="_blank" rel="noopener">sunRunner3D</a>, cuyas condiciones de frontera se obtienen de <a href="https://www.predsci.com/" target="_blank" rel="noopener">Predictive Science Inc</a>. La animación abarca el intervalo necesario para alcanzar el estado de relajación del viento solar (aproximadamente 20–30 horas en tiempo físico). A partir de ese estado relajado, se construyen las series de tiempo para compararlas con observaciones in situ de OMNI y de STEREO-A (cuando los datos estén disponibles); por ello, dichas series corresponden a un estado fijo y no representan una evolución temporal del modelo. Este video se actualizará en cada rotación de Carrington, es decir, aproximadamente una vez por mes. Para apreciar mejor los detalles, se sugiere utilizar la función de pantalla completa.
        </p>
      </div>

      <!-- Instituciones colaboradoras -->
      <div class="video-collaborators">
        <span class="video-collaborators__label" id="collaborators-label">Instituciones colaboradoras:</span>
        <div class="video-collaborators__logos">
          <a href="https://www.predsci.com/" target="_blank" rel="noopener" class="video-collaborator-logo" title="Predictive Science Inc">
            <img src="/predictive-science-logo.svg" alt="Predictive Science Inc" loading="lazy" class="logo-predsci" />
            <span class="collaborator-name">Predictive Science Inc</span>
          </a>
          <a href="https://www.enesmorelia.unam.mx/" target="_blank" rel="noopener" class="video-collaborator-logo" title="ENES Morelia">
            <img src="/logo-enes.png" alt="ENES Morelia" loading="lazy" class="logo-enes" />
            
          </a>
          <a href="/" class="video-collaborator-logo" title="LACIGE">
            <img src="/LACIGE_LOGO_FINAL_NEGRO.png" alt="LACIGE" loading="lazy" class="logo-lacige" />
            
          </a>
        </div>
      </div>
    </div>
  </section>


  <!-- Seccion de Referencias -->
  <section class="section references-section">
    <div class="container">
      <h2 class="references-title" id="references-title">Referencias</h2>
      <p class="references-legend" id="references-legend">
        Para detalles técnicos del modelo sunRunner3D y sus aplicaciones, consulte las publicaciones listadas abajo
      </p>

      <!-- Artículos Científicos -->
      <div class="references-category">
        <h3 class="references-category-title" id="references-articles-title">Artículos Científicos</h3>
        <div class="references-list">
          <!-- Artículo 1 -->
          <article class="reference-item">
            <div class="reference-item__year">
              <span>2025</span>
            </div>
            <div class="reference-item__content">
              <h4 class="reference-item__title">
                <a href="https://doi.org/10.3847/2041-8213/ae1a5e" target="_blank" rel="noopener">
                  Global compressive oscillations in the outer solar corona driven by an extreme coronal mass ejection
                </a>
              </h4>
              <p class="reference-item__authors">
                Silva, S. S., González-Avilés, J. J., Riley, P., Ben-Nun, M., Rempel, E. L., Batista, L. F., Fedun, V.
              </p>
              <p class="reference-item__journal">
                The Astrophysical Journal Letters, Volume 994, Issue 1, L27
              </p>
              <p class="reference-item__doi">
                DOI: <a href="https://doi.org/10.3847/2041-8213/ae1a5e" target="_blank" rel="noopener">10.3847/2041-8213/ae1a5e</a>
              </p>
            </div>
          </article>

          <!-- Artículo 2 -->
          <article class="reference-item">
            <div class="reference-item__year">
              <span>2025</span>
            </div>
            <div class="reference-item__content">
              <h4 class="reference-item__title">
                <a href="https://doi.org/10.1051/swsc/2025010" target="_blank" rel="noopener">
                  Understanding the global structure of the September 5, 2022, coronal mass ejection using sunRunner3D
                </a>
              </h4>
              <p class="reference-item__authors">
                Riley, P., Ben-Nun, M., González-Avilés, J. J., Palmerio, E., Török, T., Linker, J. A., Kouloumvakos, A., Romeo, O. M., Ervin, T., Sánchez-Cano, B., Varsani, A., Laky, G., Jeszenszky, H., Orsini, S., Milillo, A., Heyner, D., Auster, H.-U., Richter, I., Schmid, D., Fischer, D.
              </p>
              <p class="reference-item__journal">
                Journal of Space Weather and Space Climate, Volume 15, Article 17
              </p>
              <p class="reference-item__doi">
                DOI: <a href="https://doi.org/10.1051/swsc/2025010" target="_blank" rel="noopener">10.1051/swsc/2025010</a>
              </p>
            </div>
          </article>

          <!-- Artículo 3 -->
          <article class="reference-item">
            <div class="reference-item__year">
              <span>2024</span>
            </div>
            <div class="reference-item__content">
              <h4 class="reference-item__title">
                <a href="https://doi.org/10.31349/revmexfis.70.031501" target="_blank" rel="noopener">
                  Investigating the effects of numerical algorithms on global magnetohydrodynamics simulations of solar wind in the inner heliosphere
                </a>
              </h4>
              <p class="reference-item__authors">
                León Alanís, L. A. de, González-Avilés, J. J., Riley, P., Ben-Nun, M.
              </p>
              <p class="reference-item__journal">
                Revista Mexicana de Física, Volume 70, Issue 3, e031501
              </p>
              <p class="reference-item__doi">
                DOI: <a href="https://doi.org/10.31349/revmexfis.70.031501" target="_blank" rel="noopener">10.31349/revmexfis.70.031501</a>
              </p>
            </div>
          </article>

          <!-- Artículo 4 -->
          <article class="reference-item">
            <div class="reference-item__year">
              <span>2024</span>
            </div>
            <div class="reference-item__content">
              <h4 class="reference-item__title">
                <a href="https://doi.org/10.1093/mnras/stae640" target="_blank" rel="noopener">
                  Numerical MHD models of stream interaction regions (SIRs) and corotating interaction regions (CIRs) using sunRunner3D: comparison with observations
                </a>
              </h4>
              <p class="reference-item__authors">
                Aguilar-Rodriguez, E., González-Avilés, J. J., Riley, P., Ben-Nun, M., Rodriguez-Martinez, M., González, R. F., Perez-Rivera, M. A., Raga-Rasmussen, A. C.
              </p>
              <p class="reference-item__journal">
                Monthly Notices of the Royal Astronomical Society, Volume 529, Issue 2, Pages 1250–1257
              </p>
              <p class="reference-item__doi">
                DOI: <a href="https://doi.org/10.1093/mnras/stae640" target="_blank" rel="noopener">10.1093/mnras/stae640</a>
              </p>
            </div>
          </article>

          <!-- Artículo 5 -->
          <article class="reference-item">
            <div class="reference-item__year">
              <span>2024</span>
            </div>
            <div class="reference-item__content">
              <h4 class="reference-item__title">
                <a href="https://doi.org/10.1051/swsc/2024014" target="_blank" rel="noopener">
                  Using sunRunner3D to interpret the global structure of the heliosphere from in situ measurements
                </a>
              </h4>
              <p class="reference-item__authors">
                González-Avilés, J. J., Riley, P., Ben-Nun, M., Mayank, P., Vaidya, B.
              </p>
              <p class="reference-item__journal">
                Journal of Space Weather and Space Climate, Volume 14, Article 12
              </p>
              <p class="reference-item__doi">
                DOI: <a href="https://doi.org/10.1051/swsc/2024014" target="_blank" rel="noopener">10.1051/swsc/2024014</a>
              </p>
            </div>
          </article>
        </div>
      </div>

      <!-- Tesis -->
      <div class="references-category">
        <h3 class="references-category-title" id="references-theses-title">Tesis</h3>
        <div class="references-list">
          <!-- Tesis 1 -->
          <article class="reference-item">
            <div class="reference-item__year">
              <span>2024</span>
            </div>
            <div class="reference-item__content">
              <h4 class="reference-item__title">
                <a href="/tesis/Tesis_OROP_version_final.pdf" target="_blank" rel="noopener">
                  Modelado de la estructura magnética interna de las eyecciones de masa coronal usando una cuerda de flujo toroidal
                </a>
              </h4>
              <p class="reference-item__authors">
                Orozco Plascencia, Ozzy Rigoberto
              </p>
              <p class="reference-item__journal" id="thesis-1-journal">
                Tesis de Licenciatura, Facultad de Ciencias Físico Matemáticas, Universidad Michoacana de San Nicolás de Hidalgo
              </p>
              <a href="/tesis/Tesis_OROP_version_final.pdf" target="_blank" rel="noopener" class="reference-item__download" id="thesis-1-download">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                <span>Descargar PDF</span>
              </a>
            </div>
          </article>

          <!-- Tesis 2 -->
          <article class="reference-item">
            <div class="reference-item__year">
              <span>2024</span>
            </div>
            <div class="reference-item__content">
              <h4 class="reference-item__title">
                <a href="https://hdl.handle.net/20.500.14330/TES01000853329" target="_blank" rel="noopener">
                  Simulaciones numéricas MHD de la propagación de eyecciones de masa coronal en la heliosfera interna y su comparación con mediciones in situ
                </a>
              </h4>
              <p class="reference-item__authors">
                Medina del Ángel, Marco Antonio Alonso
              </p>
              <p class="reference-item__journal" id="thesis-2-journal">
                Tesis de Licenciatura, Escuela Nacional de Estudios Superiores (Unidad Morelia), Universidad Nacional Autónoma de México
              </p>
              <a href="https://hdl.handle.net/20.500.14330/TES01000853329" target="_blank" rel="noopener" class="reference-item__download" id="thesis-2-download">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                <span>Descargar PDF</span>
              </a>
            </div>
          </article>
        </div>
      </div>
    </div>
  </section>

</Layout>

<script>
  const i18n: Record<string, Record<string, string>> = {
    es: {
      sectionLabel: 'Investigación',
      pageTitle: 'Simulaciones globales MHD de corrientes de viento solar usando sunRunner3D',
      updated: 'Actualizado el:',
      description: `Esta visualización muestra las corrientes de viento solar simuladas con el modelo <a href="https://github.com/predsci/sunRunner3D-manuscript" target="_blank" rel="noopener">sunRunner3D</a>, cuyas condiciones de frontera se obtienen de <a href="https://www.predsci.com/" target="_blank" rel="noopener" class="link-style">Predictive Science Inc</a>. La animación abarca el intervalo necesario para alcanzar el estado de relajación del viento solar (aproximadamente 20–30 horas en tiempo físico). A partir de ese estado relajado, se construyen las series de tiempo para compararlas con observaciones in situ de OMNI y de STEREO-A (cuando los datos estén disponibles); por ello, dichas series corresponden a un estado fijo y no representan una evolución temporal del modelo. Este video se actualizará en cada rotación de Carrington, es decir, aproximadamente una vez por mes. Para apreciar mejor los detalles, se sugiere utilizar la función de pantalla completa.`,
      collaboratorsLabel: 'Instituciones colaboradoras:',
      referencesTitle: 'Referencias',
      referencesLegend: 'Para detalles técnicos del modelo sunRunner3D y sus aplicaciones, consulte las publicaciones listadas abajo',
      referencesArticlesTitle: 'Artículos Científicos',
      referencesThesesTitle: 'Tesis',
      thesis1Journal: 'Tesis de Licenciatura, Facultad de Ciencias Físico Matemáticas, Universidad Michoacana de San Nicolás de Hidalgo',
      thesis2Journal: 'Tesis de Licenciatura, Escuela Nacional de Estudios Superiores (Unidad Morelia), Universidad Nacional Autónoma de México',
      downloadPdf: 'Descargar PDF'
    },
    en: {
      sectionLabel: 'Research',
      pageTitle: 'Global MHD Simulations of Solar Wind Streams Using sunRunner3D',
      updated: 'Updated:',
      description: `This visualization shows solar wind streams simulated with the <a href="https://github.com/predsci/sunRunner3D-manuscript" target="_blank" rel="noopener">sunRunner3D</a> model, whose boundary conditions are obtained from <a href="https://www.predsci.com/" target="_blank" rel="noopener" class="link-style">Predictive Science Inc</a>. The animation spans the interval required to reach the solar wind relaxation state (approximately 20–30 hours in physical time). From that relaxed state, time series are constructed for comparison with in situ observations from OMNI and STEREO-A (when data are available); therefore, these series correspond to a steady state and do not represent a temporal evolution of the model. This video will be updated every Carrington rotation, approximately once per month. For better detail, full-screen viewing is recommended.`,
      collaboratorsLabel: 'Collaborating institutions:',
      referencesTitle: 'References',
      referencesLegend: 'For technical details on the sunRunner3D model and its applications, see the publications listed below',
      referencesArticlesTitle: 'Scientific Articles',
      referencesThesesTitle: 'Theses',
      thesis1Journal: "Bachelor's Thesis, Faculty of Physical-Mathematical Sciences, Universidad Michoacana de San Nicolás de Hidalgo",
      thesis2Journal: "Bachelor's Thesis, Escuela Nacional de Estudios Superiores (Morelia Campus), Universidad Nacional Autónoma de México",
      downloadPdf: 'Download PDF'
    }
  };

  function formatDateTime(date: Date, lang: string): string {
    const options: Intl.DateTimeFormatOptions = { 
      weekday: 'long', 
      year: 'numeric', 
      month: 'long', 
      day: 'numeric', 
      hour: '2-digit', 
      minute: '2-digit', 
      second: '2-digit', 
      timeZone: 'UTC', 
      timeZoneName: 'short' 
    };
    return date.toLocaleString(lang === 'es' ? 'es-ES' : 'en-US', options);
  }

  function updateDateTime(): void {
    const datetimeEl = document.getElementById('datetime');
    if (!datetimeEl) return;
    const lang = localStorage.getItem('prediction-lang') || 'es';
    datetimeEl.textContent = formatDateTime(new Date(), lang);
  }

  function setText(id: string, value: string): void { 
    const el = document.getElementById(id); 
    if (el) el.textContent = value; 
  }

  function setHTML(id: string, value: string): void {
    const el = document.getElementById(id);
    if (el) el.innerHTML = value;
  }

  function applyLanguage(lang: string): void {
    const t = i18n[lang] || i18n.es;
    setText('section-label', t.sectionLabel);
    setText('page-title', t.pageTitle);
    setText('timestamp-label', t.updated);
    setHTML('video-description', t.description);
    setText('collaborators-label', t.collaboratorsLabel);
    setText('references-title', t.referencesTitle);
    setText('references-legend', t.referencesLegend);
    setText('references-articles-title', t.referencesArticlesTitle);
    setText('references-theses-title', t.referencesThesesTitle);
    setText('thesis-1-journal', t.thesis1Journal);
    setText('thesis-2-journal', t.thesis2Journal);
    document.querySelectorAll('.reference-item__download span').forEach(span => {
      span.textContent = t.downloadPdf;
    });
    updateDateTime();
  }

  let dateInterval: ReturnType<typeof setInterval> | null = null;
  let abortController: AbortController | null = null;

  document.addEventListener('astro:page-load', () => {
    const langToggle = document.getElementById('lang-toggle');
    const langDropdown = document.getElementById('lang-dropdown');
    if (!langToggle || !langDropdown) return;

    // Limpiar estado previo (navegaciones anteriores)
    if (dateInterval) clearInterval(dateInterval);
    if (abortController) abortController.abort();
    abortController = new AbortController();
    const { signal } = abortController;

    // Fix para que el video funcione tras View Transitions
    const video = document.querySelector('video[data-video]');
    if (video) {
      const clone = video.cloneNode(true);
      video.replaceWith(clone);
    }

    // Aplicar idioma guardado
    const savedLang = localStorage.getItem('prediction-lang') || 'es';
    applyLanguage(savedLang);

    const langCurrent = document.getElementById('lang-current');
    if (langCurrent) {
      langCurrent.textContent = savedLang === 'es' ? 'ES' : 'EN';
    }

    // Toggle del dropdown
    langToggle.addEventListener('click', (e) => {
      e.stopPropagation();
      const isHidden = langDropdown.hasAttribute('hidden');
      if (isHidden) {
        langDropdown.removeAttribute('hidden');
        langToggle.setAttribute('aria-expanded', 'true');
      } else {
        langDropdown.setAttribute('hidden', '');
        langToggle.setAttribute('aria-expanded', 'false');
      }
    }, { signal });

    // Cerrar al hacer clic fuera
    document.addEventListener('click', (e) => {
      if (!langToggle.contains(e.target as Node) && !langDropdown.contains(e.target as Node)) {
        langDropdown.setAttribute('hidden', '');
        langToggle.setAttribute('aria-expanded', 'false');
      }
    }, { signal });

    // Opciones de idioma
    document.querySelectorAll('.lang-option').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const newLang = btn.getAttribute('data-lang') || 'es';
        localStorage.setItem('prediction-lang', newLang);
        applyLanguage(newLang);
        if (langCurrent) {
          langCurrent.textContent = newLang === 'es' ? 'ES' : 'EN';
        }
        langDropdown.setAttribute('hidden', '');
        langToggle.setAttribute('aria-expanded', 'false');
      }, { signal });
    });

    // Reloj en vivo
    updateDateTime();
    dateInterval = setInterval(updateDateTime, 1000);
  });

  // Limpiar interval al navegar fuera de la página
  document.addEventListener('astro:before-swap', () => {
    if (dateInterval) {
      clearInterval(dateInterval);
      dateInterval = null;
    }
    if (abortController) {
      abortController.abort();
      abortController = null;
    }
  });
</script>

<style>
  /* Header minimalista */
  .prediction-header {
    padding: var(--space-lg) 0;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
  }

  .prediction-header__content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-md);
  }

  .prediction-header__info {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .prediction-header__label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent);
  }

  .prediction-header__title {
    font-size: clamp(1.5rem, 4vw, 2rem);
    font-weight: 700;
    color: var(--color-white);
    margin: 0;
    line-height: 1.2;
  }

  .prediction-header__controls {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    flex-wrap: wrap;
  }

  .datetime {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.8);
    font-weight: 500;
  }

  /* Selector de idioma */
  .lang-switch {
    position: relative;
  }

  .lang-switch__btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(255, 255, 255, 0.1);
    border: 2px solid var(--color-accent);
    border-radius: var(--radius-sm);
    padding: 0.375rem 0.75rem;
    color: var(--color-white);
    font-weight: 600;
    font-size: 0.875rem;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .lang-switch__btn:hover {
    background: rgba(255, 255, 255, 0.2);
  }

  .lang-switch__icon {
    width: 18px;
    height: 18px;
    stroke: var(--color-accent);
  }

  .lang-dropdown {
    position: absolute;
    top: calc(100% + 0.25rem);
    right: 0;
    background: var(--color-primary);
    border: 2px solid var(--color-accent);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-lg);
    padding: 0.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    min-width: 100%;
    z-index: 1000;
  }

  .lang-dropdown[hidden] {
    display: none;
  }

