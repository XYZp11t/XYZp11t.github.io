<script>
  document.addEventListener('astro:page-load', () => {
    const video = document.querySelector('video[data-video]');
    if (!video) return;

    const clone = video.cloneNode(true);
    video.replaceWith(clone);
  });
</script>

<script is:inline>
  // Sistema de internacionalización
  const i18n = {
    es: {
      sectionLabel: 'Investigación',
      pageTitle: 'Simulación MHD del Viento Solar',
      updated: 'Actualizado el:',
      description: `Esta visualización sintetiza la velocidad y densidad del viento solar proyectadas por el modelo SunRunner3D, con base en los datos de <a href="https://www.predsci.com/" target="_blank" rel="noopener" class="link-style">Predictive Science Inc</a>. Los tonos más claros indican corrientes rápidas, mientras que los tonos más oscuros resaltan regiones de menor intensidad. Utilice la función de pantalla completa para apreciar los detalles finos.`,
      whatIsTitle: '¿Qué es el Viento Solar?',
      whatIsDescription: 'El viento solar es un flujo continuo de partículas cargadas (principalmente protones y electrones) que emana de la corona solar y se propaga por todo el Sistema Solar. Su velocidad típica oscila entre 300 y 800 km/s y puede causar efectos significativos en el entorno espacial terrestre.',
      predictionImportance: 'La simulación MHD del viento solar es fundamental para:',
      benefit1: 'Proteger satélites y astronautas',
      benefit2: 'Prevenir daños en redes eléctricas',
      benefit3: 'Mantener comunicaciones de radio estables',
      benefit4: 'Asegurar la precisión del GPS',
      collaboratorsLabel: 'Instituciones colaboradoras:'
    },
    en: {
      sectionLabel: 'Research',
      pageTitle: 'Solar Wind MHD Simulation',
      updated: 'Updated:',
      description: `This visualization summarizes the projected solar wind speed and density from the SunRunner3D model, based on data from <a href="https://www.predsci.com/" target="_blank" rel="noopener" class="link-style">Predictive Science Inc</a>. Lighter tones indicate faster streams, while darker tones highlight regions of lower intensity. Use full screen to examine fine details.`,
      whatIsTitle: 'What is the Solar Wind?',
      whatIsDescription: 'The solar wind is a continuous flow of charged particles (mainly protons and electrons) emanating from the solar corona and propagating throughout the solar system. Its typical velocity ranges between 300 and 800 km/s, and it can cause significant effects on Earth\'s space environment.',
      predictionImportance: 'MHD solar wind simulation is essential for:',
      benefit1: 'Protecting satellites and astronauts',
      benefit2: 'Preventing damage to power grids',
      benefit3: 'Maintaining stable radio communications',
      benefit4: 'Ensuring GPS accuracy',
      collaboratorsLabel: 'Collaborating institutions:'
    }
  };

  // Formateo de fecha y hora según idioma
  function formatDateTime(date, lang) {
    const options = { 
      weekday: 'long', 
      year: 'numeric', 
      month: 'long', 
      day: 'numeric', 
      hour: '2-digit', 
      minute: '2-digit', 
      second: '2-digit', 
      timeZone: 'UTC', 
      timeZoneName: 'short' 
    };
    return date.toLocaleString(lang === 'es' ? 'es-ES' : 'en-US', options);
  }

  function updateDateTime() {
    const datetimeEl = document.getElementById('datetime');
    if (!datetimeEl) return;
    const lang = localStorage.getItem('prediction-lang') || 'es';
    const now = new Date();
    datetimeEl.textContent = formatDateTime(now, lang);
  }

  function setText(id, value) { 
    const el = document.getElementById(id); 
    if (el) el.textContent = value; 
  }

  function setHTML(id, value) {
    const el = document.getElementById(id);
    if (el) el.innerHTML = value;
  }

  function applyLanguage(lang) {
    const t = i18n[lang] || i18n.es;
    setText('section-label', t.sectionLabel);
    setText('page-title', t.pageTitle);
    setText('timestamp-label', t.updated);
    setHTML('video-description', t.description); // Cambiado a setHTML
    setText('what-is-title', t.whatIsTitle);
    setText('what-is-description', t.whatIsDescription);
    setText('prediction-importance', t.predictionImportance);
    setText('benefit-1', t.benefit1);
    setText('benefit-2', t.benefit2);
    setText('benefit-3', t.benefit3);
    setText('benefit-4', t.benefit4);
    setText('collaborators-label', t.collaboratorsLabel);
    updateDateTime();
  }

  // Inicialización
  const savedLang = localStorage.getItem('prediction-lang') || 'es';
  applyLanguage(savedLang);
  
  const langCurrent = document.getElementById('lang-current');
  if (langCurrent) {
    langCurrent.textContent = savedLang === 'es' ? 'ES' : 'EN';
  }

  // Manejo del dropdown de idioma
  const langToggle = document.getElementById('lang-toggle');
  const langDropdown = document.getElementById('lang-dropdown');
  
  if (langToggle && langDropdown) {
    langToggle.addEventListener('click', (e) => {
      e.stopPropagation();
      const isHidden = langDropdown.hasAttribute('hidden');
      if (isHidden) {
        langDropdown.removeAttribute('hidden');
        langToggle.setAttribute('aria-expanded', 'true');
      } else {
        langDropdown.setAttribute('hidden', '');
        langToggle.setAttribute('aria-expanded', 'false');
      }
    });

    document.addEventListener('click', (e) => {
      if (!langToggle.contains(e.target) && !langDropdown.contains(e.target)) {
        langDropdown.setAttribute('hidden', '');
        langToggle.setAttribute('aria-expanded', 'false');
      }
    });

    document.querySelectorAll('.lang-option').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const newLang = btn.getAttribute('data-lang');
        localStorage.setItem('prediction-lang', newLang);
        applyLanguage(newLang);
        if (langCurrent) {
          langCurrent.textContent = newLang === 'es' ? 'ES' : 'EN';
        }
        langDropdown.setAttribute('hidden', '');
        langToggle.setAttribute('aria-expanded', 'false');
      });
    });
  }

  // Inicializar y actualizar fecha/hora cada segundo
  updateDateTime();
  setInterval(updateDateTime, 1000);
</script>

