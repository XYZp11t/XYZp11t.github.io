import Layout from '../../layouts/Layout.astro';

// Partículas radiales en todas las direcciones (360°)
const radialParticles = Array.from({ length: 24 }, (_, i) => {
  const angleDeg = (360 / 24) * i;
  const angle = (angleDeg * Math.PI) / 180;
  const distance = 32 + (i % 5) * 5;
  const dx = Math.cos(angle) * distance;
  const dy = Math.sin(angle) * distance;
  const size = 3 + (i % 4);
  const duration = 2.2 + (i % 5) * 0.3;
  const delay = i * 0.12;
  return {
    dx: dx.toFixed(2),
    dy: dy.toFixed(2),
    size,
    duration: duration.toFixed(2),
    delay: delay.toFixed(2),
  };
});

const directedParticles = Array.from({ length: 6 }, (_, i) => {
  const dy = (i - 1.5) * 14.5;
  const dx = 66 + (i % 2 ? 1.5 : -1.5);
  const size = 6 + (i % 3);
  const duration = 3.5 + i * 0.25;
  const delay = 0.5 + i * 0.45;
  return {
    dx: dx.toFixed(2),
    dy: dy.toFixed(2),
    size,
    duration: duration.toFixed(2),
    delay: delay.toFixed(2),
  };
});
